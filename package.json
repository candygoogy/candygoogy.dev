{
  "name": "candygoogy.dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/fonts.mjs && node scripts/github-data.mjs && node scripts/avatar.mjs && node scripts/icons.mjs && astro dev",
    "fonts": "node scripts/fonts.mjs",
    "build": "node scripts/fonts.mjs && node scripts/github-data.mjs && node scripts/avatar.mjs && node scripts/icons.mjs && astro build",
    "preview": "wrangler dev",
    "lint": "eslint . && prettier --check .",
    "typecheck": "astro check && svelte-check --fail-on-warnings && tsc -p worker",
    "format": "prettier --write .",
    "shots": "node scripts/shots.mjs",
    "data": "node scripts/github-data.mjs && node scripts/avatar.mjs && node scripts/icons.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/svelte": "9.0.1",
    "astro": "7.3.8",
    "sharp": "0.35.5",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261011.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.0.1",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-svelte": "3.23.1",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "wrangler": "4.149.0"
  }
}

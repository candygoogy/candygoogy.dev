---
// The 404: a large "404" that types in like the intro's wordmark, then the
// page's own words and the way home. Beside them, a three-hop status
// trace (you, this site, this page), drawn once in hairlines: the first
// two work, the page isn't found. With JS the last hop is also a button
// that tries the oldest IT fix (scripts/motion/notfound.ts).
import Base from "../layouts/Base.astro";

// Every state a hop can show, stacked in one cell so the status keeps the
// width of the longest and nothing moves when it changes.
const states = {
  checking: "Checking…",
  ok: "Working",
  missing: "Not found",
  restarting: "Restarting…",
};

const hops = [
  { label: "You", state: "ok", icon: "laptop" },
  { label: "candygoogy.dev", state: "ok", icon: "globe" },
  { label: "This page", state: "missing", icon: "page" },
] as const;
---

<Base
  title="Page not found – candygoogy"
  description="There’s nothing at this address."
  noindex
>
  <section class="nf" aria-labelledby="nf-title">
    <div class="lost">
      <p class="code" aria-hidden="true">
        {[..."404"].map((ch, i) => (
          <span class="l" data-i={i}>
            <span>{ch}</span>
          </span>
        ))}
      </p>
      <h1 id="nf-title">
        <span class="rv-mask" data-d="260">
          <span>Page not found</span>
        </span>
      </h1>
      <p class="lede rv" data-d="380">
        There’s nothing at this address. It may have moved, or the link has a
        typo.
      </p>
      <p class="back rv" data-d="500">
        <a class="tap" href="/">
          Back to candygoogy.dev
        </a>
      </p>
    </div>

    <div class="trace" data-trace data-motion="notfound">
      <span class="tick tl" aria-hidden="true"></span>
      <span class="tick tr" aria-hidden="true"></span>
      <span class="tick bl" aria-hidden="true"></span>
      <span class="tick br" aria-hidden="true"></span>
      <p class="panel-head">
        <span>Route check</span>
        <span data-time-value></span>
      </p>
      <div class="panel-body">
        <ol class="hops">
          {hops.map((hop, i) => (
            <li class="hop" data-hop={i + 1}>
              <span class="node">
                <span class="glyph" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28">
                    {hop.icon === "laptop" && (
                      <>
                        <rect x="4" y="5" width="16" height="11" rx="1.5" />
                        <path d="M2 19h20" />
                      </>
                    )}
                    {hop.icon === "globe" && (
                      <>
                        <circle cx="12" cy="12" r="8.5" />
                        <path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.1 3.6 8.5s-1.2 6.2-3.6 8.5c-2.4-2.3-3.6-5.1-3.6-8.5s1.2-6.2 3.6-8.5Z" />
                      </>
                    )}
                    {hop.icon === "page" && (
                      <>
                        <path d="M6.5 3.5h7.5l4 4v13h-11.5Z" />
                        <path d="M14 3.5v4h4M9.5 13h5M9.5 16.5h3" />
                      </>
                    )}
                  </svg>
                </span>
                <span class="num" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="label">{hop.label}</span>
                <span class="visually-hidden">, </span>
                <span class="status" data-state={hop.state}>
                  <span class="dot" aria-hidden="true"></span>
                  <span class="states" aria-hidden="true">
                    {Object.entries(states).map(([key, text]) =>
                      key === "checking" ? (
                        // Its dots are separate, so they can appear in
                        // turn while the hop is being checked.
                        <span data-is={key}>
                          Checking
                          <span class="dots">
                            <span>.</span>
                            <span>.</span>
                            <span>.</span>
                          </span>
                        </span>
                      ) : (
                        <span data-is={key}>{text}</span>
                      ),
                    )}
                  </span>
                  <span class="visually-hidden" data-sr>
                    {states[hop.state]}
                  </span>
                </span>
                {hop.icon === "page" && <span class="path" data-path />}
              </span>
            </li>
          ))}
        </ol>
        <p class="egg-line" aria-live="polite" data-egg-line></p>
      </div>
      <dl class="meta leaders">
        <div>
          <dt>Status</dt>
          <dd>404</dd>
        </div>
        <div hidden data-meta-path>
          <dt>Path</dt>
          <dd data-path-value></dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

<style>
  /* The 404 and its words on the left, the trace on the right (6:5, so
     three hops have room); stacked on narrow screens. */
  .nf {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--gap-hero);
    align-items: stretch;
    padding-block: var(--space-hero-top) var(--space-hero-bottom);
  }

  /* A short page: the body fills the window and the main area takes the
     slack, so the footer sits at the bottom instead of mid-screen. */
  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  :global(body > main) {
    flex: 1 0 auto;
    width: 100%;
  }

  :global(body > header),
  :global(body > footer) {
    width: 100%;
  }

  /* The decorative "404": the display face at its heaviest. Each digit
     rises out of its own clip, like the intro's wordmark. */
  /* Trimmed to the cap height and the baseline (where supported), so the
     panel beside it starts level with the digits' tops. The figures stand
     0.022em taller than the face's cap-height metric, the trim's edge:
     the top margin brings their tops level with the panel's. */
  .code {
    margin: 0.022em 0 var(--sp-6);
    text-box: trim-both cap alphabetic;
    font: var(--fw-d-heavy) clamp(6rem, 2.5rem + 15vw, 14rem) / 0.82
      var(--ff-display);
    letter-spacing: var(--ls-band);
    color: var(--ink);
  }

  /* The figures reach about 0.06em above each digit's box at this line
     height. They sit on the baseline, well inside the box's bottom, so
     the clip ends there: any lower and the tops would show before the
     rise. */
  .l {
    display: inline-block;
    clip-path: inset(-0.1em -0.06em 0 -0.06em);
  }

  .l > span {
    display: inline-block;
  }

  /* The intro wordmark's motion (Curtain.astro): 620ms on the site's
     curve, 30ms apart, fading up over the first 60%. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .l > span {
      animation: nf-rise 620ms var(--ease-out) calc(60ms + var(--i) * 30ms) both;
    }
  }

  /* Played once: never again after the motion setting has changed during
     the visit (html.motion-settled, motion.css). */
  :global(html.motion-settled) .l > span {
    animation: none;
  }

  @keyframes nf-rise {
    from {
      transform: translateY(110%);
      opacity: 0;
    }
    60% {
      opacity: 1;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  h1 {
    font-size: var(--fs-d-hero);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-hero);
  }

  .lede,
  .back {
    max-width: var(--measure-lede);
    margin-top: var(--sp-5);
    font-size: var(--fs-lede);
    color: var(--soft);
  }

  /* Its box ends on the baseline, so the panel's bottom meets it. */
  .back {
    text-box: trim-end cap alphabetic;
  }

  /* The trace is one instrument panel: a hairline frame with registration
     ticks at its outer corners; a header (what it is, the request's time
     in UTC), the trace itself, and a footer (status, path), each part
     ruled off by a hairline. At desktop it spans the left column's height,
     from the top of the 404 to the back link. */
  .trace {
    position: relative;
    display: flex;
    flex-direction: column;
    border: var(--rule) solid var(--chip-line);
  }

  .panel-head,
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
    margin: 0;
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-xs);
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }

  .panel-head {
    justify-content: space-between;
    border-bottom: var(--rule) solid var(--chip-line);
    color: var(--soft);
  }

  /* The trace's scale, set once here and stepped down for narrower
     panels: the icon box and icon, and the type. */
  .panel-body {
    --g: 64px;
    --ic: 44px;
    --arrow: 8px;
    --label: var(--fs-lede);
    --state: var(--fs-body);
    container-type: inline-size;
    display: grid;
    flex: 1;
    align-content: center;
    gap: var(--sp-5);
    /* The hops sit in the middle of the panel, the reply's line under
       them: the space above matches the line, its gap and the space
       below. The total stays what it was, so the panel keeps its size. */
    --reply: calc(1.6 * var(--fs-body));
    --air: calc((var(--sp-7) - var(--reply)) / 2);
    padding: calc(var(--air) + var(--sp-5) + var(--reply)) var(--sp-4)
      var(--air);
  }

  /* A narrower panel (the 1024 column): one step down, so the three hops
     still fit "candygoogy.dev". */
  @container (max-width: 460px) {
    .hops {
      --g: 52px;
      --ic: 32px;
      --arrow: 7px;
      --label: var(--fs-body);
      --state: var(--fs-sm);
    }
  }

  .meta {
    border-top: var(--rule) solid var(--chip-line);
  }

  .tick {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 0 solid var(--soft);
  }

  .tl {
    top: -1px;
    left: -1px;
    border-width: 1px 0 0 1px;
  }

  .tr {
    top: -1px;
    right: -1px;
    border-width: 1px 1px 0 0;
  }

  .bl {
    bottom: -1px;
    left: -1px;
    border-width: 0 0 1px 1px;
  }

  .br {
    right: -1px;
    bottom: -1px;
    border-width: 0 1px 1px 0;
  }

  .hops {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hop {
    position: relative;
  }

  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
  }

  button.node {
    border-radius: 10px;
    cursor: pointer;
    transition: transform 120ms var(--ease-ui);
  }

  @media (prefers-reduced-motion: no-preference) {
    button.node:active {
      transform: scale(0.97);
    }
  }

  /* The egg's quiet affordance: the page icon gets a hairline frame on
     hover, enough for the curious to try it. Touch screens get the same
     frame once, fading, when the trace is done (the script). */
  @media (hover: hover) {
    button.node:hover .glyph {
      box-shadow: inset 0 0 0 var(--rule) var(--chip-line);
    }
  }

  .glyph.cue {
    animation: egg-cue 1.2s var(--ease-out) forwards;
  }

  @keyframes egg-cue {
    from {
      box-shadow: inset 0 0 0 var(--rule) var(--chip-line);
    }
    to {
      box-shadow: inset 0 0 0 var(--rule) transparent;
    }
  }

  button.node:focus-visible {
    outline: var(--focus-width) solid var(--focus);
    outline-offset: 4px;
  }

  .glyph {
    display: grid;
    place-items: center;
    width: var(--g);
    height: var(--g);
    border-radius: 12px;
    color: var(--ink);
    transition: box-shadow var(--dur-ui) var(--ease-out);
  }

  /* The stroke stays 1.5px at any icon size. */
  .glyph svg {
    width: var(--ic);
    height: var(--ic);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .glyph svg * {
    vector-effect: non-scaling-stroke;
  }

  /* The link to the next hop: from beside this icon to beside the next
     one, at the icons' centre line. A border, like the arrowhead, so it
     snaps to whole device pixels and keeps one weight as it draws. */
  .hop:not(:last-child)::after {
    content: "";
    position: absolute;
    top: calc(var(--g) / 2);
    left: calc(50% + var(--g) / 2 + 6px);
    width: calc(100% - var(--g) - 12px);
    height: 0;
    border: 0 solid var(--soft);
    border-top-width: var(--rule);
    transform-origin: left center;
  }

  /* The arrowhead at the receiving end: a chevron, scaled with the icons,
     its tip on the line's end. */
  .hop:not(:last-child)::before {
    content: "";
    position: absolute;
    top: calc(var(--g) / 2 - var(--arrow) / 2);
    left: calc(150% - var(--g) / 2 - 6px - var(--arrow) * 1.2);
    width: var(--arrow);
    height: var(--arrow);
    border: solid var(--soft);
    border-width: var(--rule) var(--rule) 0 0;
    transform: rotate(45deg);
  }

  .num {
    margin-top: var(--sp-3);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    color: var(--soft);
  }

  .label {
    margin-top: var(--sp-1);
    font: var(--fw-d-bold) var(--label) / 1.25 var(--ff-display);
    letter-spacing: var(--ls-d-sm);
    color: var(--ink);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-1);
    font-size: var(--state);
    color: var(--soft);
  }

  /* Square-ish dots: green working, grey while checking, a hollow red
     ring when not found. The green is a layer over the grey (::before),
     so it can fill in from the centre; ::after is the one ring a hop
     sends out as it resolves (scripts/motion/notfound.ts). */
  .dot {
    position: relative;
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--st-offline);
  }

  .dot::before,
  .dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    opacity: 0;
    pointer-events: none;
  }

  .dot::before {
    background: var(--st-online);
  }

  .dot::after {
    box-shadow: 0 0 0 1px var(--st-online);
  }

  .status[data-state="ok"] .dot::before {
    opacity: 1;
  }

  .status[data-state="missing"] .dot {
    background: none;
    box-shadow: inset 0 0 0 1.5px var(--st-missing);
  }

  /* The words share one cell, clipped above and below, so a changing
     word can leave upward and the next rise in from under it. */
  .states {
    display: inline-grid;
    clip-path: inset(0 -0.5em);
    /* Every word starts right by the dot, whatever its length (the cell
       keeps the width of the longest, centred with the hop). */
    text-align: start;
  }

  .states > span {
    grid-area: 1 / 1;
    visibility: hidden;
    white-space: nowrap;
  }

  /* An answer reads in ink; the in-between states stay soft. */
  .status[data-state="ok"] [data-is="ok"],
  .status[data-state="missing"] [data-is="missing"] {
    color: var(--ink);
  }

  /* While a hop is being checked, the dots of "Checking..." appear in
     turn, 0.18s apart, and start again: only while it's checking (it
     ends as the hop answers). Still under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .status[data-state="checking"] .dots > span {
      animation: dot-1 720ms infinite;
    }

    .status[data-state="checking"] .dots > span:nth-child(2) {
      animation-name: dot-2;
    }

    .status[data-state="checking"] .dots > span:nth-child(3) {
      animation-name: dot-3;
    }
  }

  @keyframes dot-1 {
    0%,
    24.9% {
      opacity: 0;
    }
    25%,
    100% {
      opacity: 1;
    }
  }

  @keyframes dot-2 {
    0%,
    49.9% {
      opacity: 0;
    }
    50%,
    100% {
      opacity: 1;
    }
  }

  @keyframes dot-3 {
    0%,
    74.9% {
      opacity: 0;
    }
    75%,
    100% {
      opacity: 1;
    }
  }

  .states > [data-leaving],
  .status[data-state="checking"] [data-is="checking"],
  .status[data-state="ok"] [data-is="ok"],
  .status[data-state="missing"] [data-is="missing"],
  .status[data-state="restarting"] [data-is="restarting"] {
    visibility: visible;
  }

  /* The path under "This page": its line is kept even when empty (no
     JS), so nothing moves when it fills in. */
  .path {
    display: block;
    max-width: 100%;
    min-height: 1.4em;
    margin-top: var(--sp-1);
    overflow: hidden;
    font-size: var(--fs-xs);
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: var(--soft);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The sequence (JS, motion allowed): hops wait unseen and links
     undrawn from the first paint until the script (loaded after it)
     reaches them, and all show on their own at 4s if it never does. The
     panel is on screen at load, so this keys on .js (set before the first
     paint), not .motion-ready, which would show the end state first. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .trace:not([data-done]) .hop:not([data-shown]) {
      opacity: 0;
      transform: translateY(24px);
      animation: trace-shown 1ms linear 4000ms forwards;
    }

    :global(html.js) .trace:not([data-done]) .hop:not([data-drawn])::after {
      transform: scaleX(0);
      animation: trace-drawn 1ms linear 4000ms forwards;
    }

    :global(html.js) .trace:not([data-done]) .hop:not([data-drawn])::before {
      opacity: 0;
      animation: trace-shown 1ms linear 4000ms forwards;
    }
  }

  @keyframes trace-shown {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes trace-drawn {
    to {
      transform: none;
    }
  }

  /* The footer's pairs: real values only (the status; with JS the path),
     labels soft, values ink, a dotted leader (base.css) between them.
     The pairs share the line. */
  .meta > div {
    display: flex;
    flex: 1 1 auto;
    align-items: baseline;
    min-width: 0;
  }

  .meta > div[hidden] {
    display: none;
  }

  .meta dt {
    flex: 1 0 auto;
    color: var(--soft);
  }

  .meta dd {
    min-width: 0;
    max-width: 28ch;
    margin: 0;
    overflow: hidden;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The reply's line, its space kept so nothing moves when it appears. */
  .egg-line {
    min-height: 1.6em;
    margin: 0;
    font-size: var(--fs-body);
    color: var(--soft);
    text-align: center;
  }

  /* The narrower desktop column (around 1024): a little less air in the
     panel, so it never outgrows the text beside it. */
  @media (max-width: 75rem) {
    .panel-body {
      padding-block: var(--sp-5) var(--sp-4);
    }
  }

  @media (max-width: 53.75rem) {
    .nf {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .panel-body {
      padding-top: var(--sp-6);
    }
  }

  /* Phones: the hops stack, icon on the left, the link running down. */
  @media (max-width: 32.5rem) {
    .hops {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }

    .node {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      column-gap: var(--sp-3);
      align-items: center;
      justify-items: start;
      text-align: left;
    }

    .glyph {
      grid-row: 1 / span 4;
      align-self: start;
    }

    .num {
      margin-top: 0;
    }

    .hops {
      --g: 44px;
      --ic: 28px;
      --arrow: 6px;
      --label: var(--fs-body);
      --state: var(--fs-sm);
    }

    .hop:not(:last-child)::after {
      top: calc(var(--g) + 6px);
      left: calc(var(--g) / 2);
      width: 0;
      height: calc(100% - var(--g) - 12px + var(--sp-5));
      border-width: 0 0 0 var(--rule);
      transform-origin: center top;
    }

    .hop:not(:last-child)::before {
      top: calc(100% + var(--sp-5) - 6px - var(--arrow) * 1.2);
      left: calc(var(--g) / 2 - var(--arrow) / 2 + 0.5px);
      transform: rotate(135deg);
    }

    :global(html.js) .trace:not([data-done]) .hop:not([data-drawn])::after {
      transform: scaleY(0);
    }
  }

  /* Phones: each value under its label, no leader. */
  @media (max-width: 32.5rem) {
    .meta > div {
      flex-direction: column;
      flex-grow: 0;
      align-items: start;
    }
  }

  @media (max-width: 22.5rem) {
    .meta {
      flex-direction: column;
    }
  }

  /* Paper lists the hops one under another (print.css), so the links and
     arrowheads drawn between them across the panel have nowhere to go. */
  @media print {
    .hop::before,
    .hop::after {
      display: none;
    }
  }

  /* Forced colors (Windows Contrast themes): a hop's dot is its state
     (green working, grey checking, a red ring not found), so it keeps
     its colors. */
  @media (forced-colors: active) {
    .dot {
      forced-color-adjust: none;
    }
  }
</style>

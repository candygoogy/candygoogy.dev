---
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import FettleBand from "../components/FettleBand.astro";
import Hero from "../components/Hero.astro";
import ProjectNames from "../components/ProjectNames.astro";
import ProjectRows from "../components/ProjectRows.astro";
import Previews from "../components/Previews.astro";
import { featuredProject, site } from "../data/site";
import Base from "../layouts/Base.astro";
import { featuredProjects, orderedProjects, ownPages } from "../lib/projects";

const projects = await orderedProjects();
// The band is the featured product's alone; the other featured projects
// are the rows here, and the list closes on the rest, named and linked to
// /projects, where every project is.
const band = projects.find((p) => p.id === featuredProject);
const shortlist = featuredProjects(projects).filter(
  (p) => p.id !== featuredProject,
);
const rest = projects.filter(
  (p) => p.id !== featuredProject && !shortlist.includes(p),
);

// Structured data: who the site belongs to (the public handle only).
const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  sameAs: [site.github, site.x, site.telegram],
};
---

<Base title={site.name} description={site.description} intro schema={schema}>
  <ProjectNames slot="head" projects={ownPages(projects)} />
  <Hero projects={projects} />
  {band && <FettleBand project={band} />}
  <ProjectRows
    projects={shortlist}
    id="projects"
    title="More things I’ve made"
    aliases={["websites", "side-projects"]}
    more={rest}
  />
  <About />
  <Contact />
  <Previews />
</Base>

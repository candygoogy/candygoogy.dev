---
// Every published project, in the site's order, grouped by kind under
// its heading: the products two across, in the same shape as the home
// page's (linked from under it), then side projects and websites. The
// featured product is an entry here too, linking to its page.
import ProjectRows from "../components/ProjectRows.astro";
import { hero, site } from "../data/site";
import Base from "../layouts/Base.astro";
import { orderedProjects } from "../lib/projects";

const projects = await orderedProjects();
// One group per kind, in the site's order (lib/projects.ts sorts by kind
// first, so each keeps its own order); a kind with no projects is left out.
// The groups share one #projects, so every row is still under it.
const groups = [
  { kind: "product", id: "products", title: "Products" },
  { kind: "side", id: "side-projects", title: "Side projects" },
  { kind: "website", id: "websites", title: "Websites" },
]
  .map((g) => ({ ...g, rows: projects.filter((p) => p.data.kind === g.kind) }))
  .filter((g) => g.rows.length > 0);
---

<Base
  title={`${hero.indexTitle} – ${site.name}`}
  description={`Everything ${site.name} has built: products, side projects and websites.`}
  section="Projects"
  ogImage="/og-projects.png"
  ogAlt="Projects: products, side projects and websites I’ve built."
>
  <div class="head">
    <h1 id="projects-title">
      <span class="rv-mask">
        <span>{hero.indexTitle}</span>
      </span>
    </h1>
  </div>
  <div id="projects">
    {groups.map((g) => (
      <ProjectRows projects={g.rows} id={g.id} title={g.title} across={2} />
    ))}
  </div>
</Base>

<style>
  .head {
    padding-block: var(--space-head-top) var(--space-head-bottom);
  }

  h1 {
    font-size: var(--fs-d-hero);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-hero);
  }

  /* The first group starts right under the head, not a section gap away;
     the groups are a section gap apart, like the home page's sections. */
  #projects > :global(.projects:first-child) {
    margin-top: 0;
  }
</style>

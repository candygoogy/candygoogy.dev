---
// How the site is made: a heading, a line, then one row per topic in the
// project rows' language (a label on the left, the text on the right,
// hairlines between).
import { site } from "../data/site";
import Base from "../layouts/Base.astro";
import { builtOn, commit, dirty, shortCommit } from "../lib/build";
import { listedExperiments, policyChecked } from "../lib/experiments-csp";

// The Privacy row speaks for the experiments too (each tool's footer links
// to it), but only while every tool's live security policy reads as it
// says, the same check as the /experiments lede. Otherwise it says why it
// doesn't, since the tools still link here.
const toolsChecked = policyChecked(
  (await listedExperiments()).map(({ id }) => id),
);

const credit = "https://x.com/dark_night1109/status/2104328383211737219";

// The pages the Weight row lists, by their built files. Each number is
// written in by the build (scripts/weights.mjs); in development it stays
// a dash.
const weights = [
  ["Home", "index.html"],
  ["Fettle", "fettle.html"],
  ["Install diff", "idiff.html"],
  ["Projects", "projects.html"],
  ["Experiments", "experiments.html"],
  ["Uses", "uses.html"],
  ["Colophon", "colophon.html"],
];
---

<Base
  title="Colophon – candygoogy"
  description="How this site is made, for anyone who wonders."
>
  <section class="colophon" aria-labelledby="colophon-title">
    <h1 id="colophon-title">
      <span class="rv-mask">
        <span>Colophon</span>
      </span>
    </h1>
    <p class="intro rv" data-d="200">
      How this site is made, for anyone who wonders.
    </p>

    <dl class="rows leaders">
      <div class="row rv rv-line" data-i="0" data-line="line">
        <dt>Stack</dt>
        <dd>
          <p>
            Astro builds every page ahead of time as plain HTML, and the
            interactive parts are small scripts in plain TypeScript, loaded only
            on the pages that use them. Cloudflare serves it, and a small Worker
            of my own handles the four things that can’t be static: the Discord
            status, a daily rebuild, a plain-text page for terminals and the
            Delivery numbers below.
          </p>
        </dd>
      </div>
      <div class="row rv rv-line" data-i="1" data-line="line">
        <dt>Type</dt>
        <dd>
          <p>
            Headings are set in Newsreader by Production Type, and body text in
            Schibsted Grotesk by Schibsted Media Group. Both are open source,
            under the SIL Open Font License. The fonts are served from this
            site, not from a font service.
          </p>
        </dd>
      </div>
      <div class="row rv rv-line" data-i="2" data-line="line">
        <dt>Data</dt>
        <dd>
          <p>
            Some things update by themselves. Every morning at 05:17 UTC the
            site rebuilds and picks up my latest GitHub contributions, my
            projects’ newest versions and my GitHub profile picture, which is
            also where the favicon comes from. Private work counts toward the
            contributions as plain numbers, without saying what it was.
          </p>
          <p>
            New releases and experiments are in a feed:{" "}
            <a href="/feed.xml">candygoogy.dev/feed.xml</a>.
          </p>
          <p>
            The Discord status is the one live thing. My Worker asks Lanyard for
            it and passes on only whether I’m online, idle, do not disturb or
            offline, nothing about what I’m doing.
          </p>
        </dd>
      </div>
      <!-- The footer's "No trackers, no cookies" links here, and so does
           every experiment's privacy line. -->
      <div id="privacy" class="row rv rv-line" data-i="3" data-line="line">
        <dt>Privacy</dt>
        <dd>
          <p>
            No cookies, no analytics, and nothing loaded from anyone else’s
            server. Your browser remembers two things, on your device only: the
            theme you picked, and that you’ve already seen the intro this
            session.
          </p>
          <p>
            To check it yourself, open your browser’s developer tools:
            Application › Cookies is empty, and the Network tab shows every
            request going to candygoogy.dev. The page’s security policy
            (connect-src 'self') wouldn’t let it go anywhere else.
          </p>
          {toolsChecked ? (
            <p>
              The experiments go further: each tool’s policy is connect-src
              'none', so nothing you give one can leave the page. Mail check’s
              lookups to cloudflare-dns.com are the one exception. Load any
              other tool, go offline, and it still works.
            </p>
          ) : (
            <p>
              The experiments’ own policies are checked against this every day.
              The last check didn’t pass, so for now this row speaks only for
              the site.
            </p>
          )}
        </dd>
      </div>
      <div class="row rv rv-line" data-i="4" data-line="line">
        <dt>Motion</dt>
        <dd>
          <p>
            Everything moves with CSS and the browser’s own View Transitions and
            Web Animations, with no animation library. If your system asks for
            less motion, the site keeps still. Every page also works with
            JavaScript turned off.
          </p>
        </dd>
      </div>
      <div class="row rv rv-line" data-i="5" data-line="line">
        <dt>Weight</dt>
        <dd>
          <p>
            Each page is one file with its styles inside, sent compressed. A few
            small scripts for the motion follow once it’s drawn. The numbers
            count both, but not pictures.
          </p>
          <dl class="weights leaders">
            {weights.map(([name, page]) => (
              <div>
                <dt>{name}</dt>
                <dd>
                  <span class="nobr">
                    <data value="" data-weight={page}>
                      –
                    </data>{" "}
                    KB
                  </span>
                </dd>
              </div>
            ))}
          </dl>
          <p>
            The fonts add{" "}
            <span class="nobr">
              <data value="" data-weight="fonts">
                –
              </data>{" "}
              KB
            </span>{" "}
            on your first visit, and come from your browser’s cache after that.
          </p>
        </dd>
      </div>
      <!-- This visit's numbers, written in by the Worker as the page is
           sent (worker/delivery.ts): it fills each line, drops a line it
           has no value for, and shows the row once it has the city. So it
           is in the page from its first paint, and nothing moves. Without
           the Worker (in development) it stays hidden. -->
      <div
        id="delivery"
        class="row rv rv-line"
        data-i="6"
        data-line="line"
        hidden
      >
        <dt>Delivery</dt>
        <dd>
          <p>
            Cloudflare runs this site from data centers around the world, and
            the nearest one answers. This is how this page reached you, written
            into it as it was sent to you. None of it is kept.
          </p>
          <dl class="weights leaders">
            <div data-delivery="city">
              <dt>Served from</dt>
              <dd></dd>
            </div>
            <div data-delivery="rtt">
              <dt>Round trip</dt>
              <dd></dd>
            </div>
            <div data-delivery="protocol">
              <dt>Protocol</dt>
              <dd></dd>
            </div>
          </dl>
        </dd>
      </div>
      <div class="row rv rv-line" data-i="7" data-line="line">
        <dt>Map</dt>
        <dd>
          <p>
            The same site as a small 3D network you can walk through:{" "}
            <a href="https://map.candygoogy.dev/">map.candygoogy.dev</a>.
          </p>
        </dd>
      </div>
      <div class="row rv rv-line" data-i="8" data-line="line">
        <dt>Credits</dt>
        <dd>
          <p>
            My profile picture is by <a href={credit}>@dark_night1109</a>.
          </p>
        </dd>
      </div>
      <div class="row rv rv-line" data-i="9" data-line="line">
        <dt>Source</dt>
        <dd>
          <!-- The build, as the footer's stamp gives it (the same link and
               words), since a phone's footer leaves the stamp out. -->
          <p>
            The source is <a href={site.source}>on GitHub</a>. This version was
            built on{" "}
            <time class="nobr" datetime={builtOn.iso}>
              {builtOn.label}
            </time>
            {commit && (
              <>
                {" from "}
                <a
                  href={`${site.source}/commit/${commit}`}
                  aria-label={`commit ${shortCommit}${dirty ? ", with uncommitted changes" : ""}`}
                >
                  {shortCommit}
                </a>
              </>
            )}
            . A wider screen shows it in the footer too; on a phone, it’s{" "}
            <span class="nobr">only here.</span>
          </p>
        </dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  .colophon {
    padding-top: var(--space-hero-top);
  }

  h1 {
    font-size: var(--fs-d-hero);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-hero);
  }

  .intro {
    max-width: var(--measure-lede);
    margin-top: var(--sp-5);
    font-size: var(--fs-lede);
    color: var(--soft);
  }

  .rows {
    margin: var(--sp-8) 0 0;
  }

  /* The project rows' grid: the label on the left (4), the text on the
     right (7), a hairline above each and below the last. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    column-gap: var(--gap-hero);
    row-gap: var(--sp-3);
    align-items: baseline;
    padding-block: var(--sp-6);
  }

  /* The Delivery row, until the Worker writes its numbers in. */
  .row[hidden] {
    display: none;
  }

  .row > dt {
    font: var(--fw-d-bold) var(--fs-d-sm) / var(--lh-tight) var(--ff-display);
    letter-spacing: var(--ls-d-sm);
  }

  .row > dd {
    display: grid;
    gap: var(--sp-4);
    max-width: 60ch;
    margin: 0;
    font-size: var(--fs-lede);
    color: var(--ink);
  }

  /* The weights, as on a receipt: each page's name, a dotted leader
     (base.css) and its number on the list's right edge. The numbers are
     short, so on phones too, where base.css puts a value under its
     label. */
  .weights {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
  }

  .weights > div {
    grid-template-columns: minmax(0, auto) minmax(0, max-content);
  }

  .weights dt {
    display: flex;
    color: var(--soft);
  }

  .weights dt::after {
    display: block;
  }

  .weights dd {
    font-variant-numeric: tabular-nums;
  }

  /* Side by side, a label's dotted leader (base.css) runs across the
     gap to its text. */
  @media screen and (min-width: 53.76rem) {
    .row > dt {
      margin-right: calc(-1 * var(--gap-hero));
    }
  }

  /* Stacked (and on paper), the label sits above its text, no leader. */
  @media (max-width: 53.75rem), print {
    .row > dt {
      display: block;
    }

    .row > dt::after {
      display: none;
    }
  }

  @media (max-width: 53.75rem) {
    .row {
      grid-template-columns: 1fr;
      padding-block: var(--sp-5);
    }
  }
</style>

---
// The home page hero's index, a shortlist of the featured projects: a
// heading and one row per project (its name, then its line). The menu
// (Header.astro) shows the same index, on every page.
import type { CollectionEntry } from "astro:content";
import { hero } from "../data/site";
import { vtAttr } from "../lib/vt";
import Keep from "./Keep.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  // The heading's id (unique per page).
  headingId: string;
  // Reveal delays for the heading and the first row (the rows stagger), in
  // ms: each must be one of the data-d values motion.css maps to --d.
  delay?: { title: number; rows: number };
  // In the menu, the rows are closer together, with no rules above or
  // below the list, and the menu plays their entrance as it opens.
  variant?: "hero" | "menu";
}

const {
  projects,
  headingId,
  delay = { title: 520, rows: 600 },
  variant = "hero",
} = Astro.props;
const menu = variant === "menu";

// Products open their page; everything else jumps to its own row in the
// projects list, on the home page. The link to the page you're on is
// marked as such.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const prefix = path === "/" ? "" : "/";
const href = (p: CollectionEntry<"projects">) =>
  p.data.kind === "product" ? `/${p.id}` : `${prefix}#${p.id}`;
---

<nav class:list={["index", { "in-menu": menu }]} aria-labelledby={headingId}>
  <h2
    id={headingId}
    class={menu ? undefined : "rv rv-line"}
    data-d={menu ? undefined : delay.title}
  >
    {hero.featuredTitle}
  </h2>
  <ol>
    {projects.map((p, i) => (
      <li
        class={menu ? undefined : "rv rv-line at-bottom"}
        data-d={menu ? undefined : delay.rows}
        data-i={i}
        data-line={menu ? undefined : "line"}
      >
        <a
          class="shift"
          href={href(p)}
          aria-current={href(p) === path ? "page" : undefined}
        >
          <span
            {...(p.data.kind === "product" ? vtAttr(p.id) : {})}
            class:list={[
              "name",
              { "vt-project-title": p.data.kind === "product" },
            ]}
          >
            {p.data.name}
          </span>
          <span class="blurb">
            <Keep text={p.data.blurb} />
          </span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .index h2 {
    padding-top: var(--sp-3);
    /* Room for the first row's focus ring, clear of the heading. */
    margin-bottom: var(--sp-2);
    font: var(--fw-medium) var(--fs-sm) / 1.4 var(--ff-text);
    color: var(--soft);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The name over its line. Four rows at this padding end about level
     with the line under the headline (Hero.astro). */
  .index a {
    display: grid;
    padding-block: var(--sp-5);
    background: none;
    color: var(--ink);
  }

  /* Names are one line: no extra leading above or below. */
  .name {
    font: var(--fw-bold) var(--fs-d-lg) / 1 var(--ff-display);
    letter-spacing: var(--ls-d-md);
    transition: color var(--dur-ui) var(--ease-out);
  }

  /* Hover feedback that doesn't depend on motion. */
  .index a:hover .name {
    color: var(--acc);
  }

  .blurb {
    margin-top: var(--sp-1);
    font-size: var(--fs-meta);
    color: var(--soft);
    text-wrap: balance;
  }

  /* In the menu: the heading opens the list without a rule, and the rows
     are closer, with a rule between them only (the list doesn't end on
     one). Each row is still well over 44px tall. */
  .index.in-menu h2 {
    padding-top: 0;
  }

  .index.in-menu a {
    padding-block: var(--sp-2);
  }

  .index.in-menu li + li {
    border-top: var(--rule) solid var(--line);
  }
</style>

---
import type { CollectionEntry } from "astro:content";
import { latestVersion } from "../lib/github";
import Facts from "./Facts.astro";
import Keep from "./Keep.astro";
import Shot from "./Shot.astro";
// Imported after the components: an import between them would change the
// order of the page's styles.
import { bandTitleId, vtAttr } from "../lib/vt";

interface Props {
  project: CollectionEntry<"projects">;
  // Where the band is. On the home page (false) it carries the project:
  // the name and lede, the screenshot, then the story beside the facts and
  // the link to its page. On the project's own page (true) it holds the
  // product only: the name, as the page's h1, on its own row, the lede and
  // the facts side by side under it, then the screenshot; the story is the
  // page's (ProductPage.astro).
  page?: boolean;
}

const { project, page = false } = Astro.props;
const Heading = page ? "h1" : "h2";
const { data } = project;
const shot = data.images[0];
const version = latestVersion(data.repo, data.version);
// The name's words, each letter with its index in the whole name (the
// spaces count), so a word's letters can be kept on one line together.
let at = 0;
const words = data.name.split(" ").map((word) => {
  const letters = [...word].map((ch, j) => ({ ch, i: at + j }));
  at += [...word].length + 1;
  return letters;
});
// The longest word's length in letters: the name's size is capped by it,
// so a long name fits its column instead of running into the lede.
const longest = Math.max(...words.map((letters) => letters.length));
// On the home page, without a screenshot the band is text only (.bare):
// the story sits further from the lede, so the name and its line read as
// the header, and the facts start at the lede's edge, so the right side
// has one edge. With no receipt on the page either, the story's last part
// moves under the facts (.split), so the two columns end together. On a
// product's page a band without a screenshot simply ends after the facts.
const split = !page && !shot && !data.receipt && !!data.story;
---

<section
  id={project.id}
  class:list={["band", "rv-band", { bare: !shot, split, "on-page": page }]}
  aria-labelledby={bandTitleId(project.id)}
>
  <!-- On a product's page the head's two parts and the facts share one
       grid (the head itself is display: contents there); the facts stay
       out of the head, so they arrive after the lede, as on home. -->
  <div class="band-top">
    <div class="band-head">
      <Heading
        id={bandTitleId(project.id)}
        class="title letters vt-project-title"
        style={`--word: ${longest}`}
        aria-label={data.name}
        {...vtAttr(project.id)}
      >
        {words.map((letters, w) => (
          <>
            {w > 0 && " "}
            <span class="word">
              {letters.map(({ ch, i }) => (
                <span class="l" aria-hidden="true" data-i={i}>
                  <span>{ch}</span>
                </span>
              ))}
            </span>
          </>
        ))}
      </Heading>
      <p class="lede rv" data-d="260">
        <Keep text={data.summary} />
      </p>
    </div>
    {page && <Facts data={data} version={version} />}
  </div>

  {shot && (
    <figure
      class="stage rv vt-project-shot"
      {...vtAttr(project.id)}
      data-d="380"
      data-tilt
      data-decode
    >
      <div class="tilt">
        <Shot
          src={shot.light}
          alt={shot.alt}
          sizes="(min-width: 84rem) 1200px, 90vw"
          phone={shot.phone?.light}
          eager={page}
        />
      </div>
    </figure>
  )}

  {!page && (
    <div class="zig">
      <div class="story">
        {data.story && (
          <>
            <h3 class="sub rv" data-i="0">
              Why
            </h3>
            <p class="rv" data-i="1">
              {data.story.why}
            </p>
            <h3 class="sub rv" data-i="2">
              What was hard
            </h3>
            <p class="rv" data-i="3">
              {data.story.hard}
            </p>
            <h3 class="sub rv" data-i="4">
              What it won’t do
            </h3>
            <p class="rv" data-i="5">
              {data.story.promise}
            </p>
          </>
        )}
        <p class="more rv" data-i="6">
          <a class="tap" href={`/${project.id}`}>
            {data.page?.bandLink ??
              `What ${data.name} checks, and how it handles privacy`}
          </a>
        </p>
      </div>
      <Facts data={data} version={version} />
    </div>
  )}
</section>

<script>
  // The screenshot leans a few degrees toward the pointer: fine pointers
  // only, never with reduced motion. It settles back when the pointer leaves.
  const fine = matchMedia("(hover: hover) and (pointer: fine)");
  const calm = matchMedia("(prefers-reduced-motion: reduce)");
  for (const stage of document.querySelectorAll<HTMLElement>("[data-tilt]")) {
    const tilt = stage.querySelector<HTMLElement>(".tilt");
    if (!tilt) continue;
    stage.addEventListener("pointermove", (e) => {
      if (!fine.matches || calm.matches) return;
      const r = stage.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      tilt.style.transform = `rotateX(${(-y * 5).toFixed(2)}deg) rotateY(${(x * 6).toFixed(2)}deg)`;
    });
    stage.addEventListener("pointerleave", () => {
      tilt.style.transform = "";
    });
  }
</script>

<style>
  .band {
    margin-inline: calc(-1 * var(--gutter));
    padding: var(--space-band) var(--gutter);
    /* Also the radius of its reveal clip (motion.css). */
    --band-r: var(--r-band);
    border-radius: var(--band-r);
    background: var(--band);
    color: var(--band-ink);
  }

  .band-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--sp-5) var(--sp-8);
    align-items: end;
    /* The name's size is measured against the head's width. */
    container-type: inline-size;
  }

  /* Letters clip their own rise (see motion.css). At this line height
     the display face's capitals and ascenders reach about 0.06em above
     each letter's box and its descenders 0.05em below it, and the f's
     hook overhangs its advance by about 0.15em on the right. */
  /* A line breaks between words only, never between a word's letters
     ("Insta / ll diff"). */
  .title .word {
    white-space: nowrap;
  }

  .title .l {
    display: inline-block;
    clip-path: inset(-0.1em -0.18em -0.1em -0.06em);
  }

  .title .l > span {
    display: inline-block;
  }

  /* A word in the display face is at most about 0.5em a letter wide
     (featherplay is 0.46), so a name whose longest word (--word letters)
     would be wider than its column is set smaller, to fit. Short names
     (Fettle, Install diff) never reach the cap. */
  .title {
    font-size: min(var(--fs-d-band), 100cqi * 2 / var(--word));
    font-weight: var(--fw-d-heavy);
    line-height: var(--lh-band);
    letter-spacing: var(--ls-band);
  }

  .lede {
    max-width: var(--measure-lede);
    font-size: var(--fs-lede);
    color: var(--band-soft);
  }

  .stage {
    margin: clamp(2.5rem, 6vh, 4.5rem) 0 0;
    perspective: 1400px;
  }

  .tilt {
    transition: transform var(--dur-tilt) var(--ease-out);
  }

  .stage :global(img) {
    width: 100%;
    border-radius: var(--r-shot);
  }

  /* On a product's page: the name on its own row, as wide as the band;
     under it the lede and the facts side by side, on the page's 5/6
     columns (ProductPage.astro runs them down to Privacy), the facts
     taking the wider one, so a stack of five fits its line at 1440. */
  .on-page .band-top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--sp-6) var(--sp-8);
    align-items: start;
    container-type: inline-size;
  }

  .on-page .band-head {
    display: contents;
  }

  .on-page .title {
    grid-column: 1 / -1;
    margin-bottom: calc(var(--sp-7) - var(--sp-6));
  }

  /* Beside the lede, the facts' first row sits level with its first line:
     the room above it, under its hairline, is taken from above the list. */
  .on-page .band-top > :global(.facts) {
    margin-top: calc(-1 * var(--sp-4));
  }

  .zig {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-7) var(--sp-9);
    margin-top: clamp(2.5rem, 6vh, 4rem);
  }

  .bare .zig {
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    column-gap: var(--sp-8);
    margin-top: clamp(var(--sp-8), 10vh, var(--sp-9));
  }

  .sub {
    margin-bottom: var(--sp-2);
    font-size: var(--fs-d-sm);
    letter-spacing: var(--ls-d-sm);
  }

  .story p {
    max-width: var(--measure);
    margin-bottom: var(--sp-5);
  }

  .story p.more {
    margin: var(--sp-6) 0 0;
  }

  /* Side by side, the facts' first row sits level with "Why": the room
     above it, under its hairline, is taken from above the column. The two
     columns are equal, so the facts have half the band and a stack of
     five fits its line at 1440. */
  @media (min-width: 53.76rem) {
    .zig > :global(.facts) {
      margin-top: calc(-1 * var(--sp-4));
    }

    /* Beside the lede, the name's column is 5/11 of the head after the
       gap; the name is no wider than that. Its column can't be narrower
       than its longest word either, so a wider name than the cap allows
       for pushes the lede over rather than running into it. */
    .band:not(.on-page) .band-head {
      grid-template-columns: minmax(auto, 5fr) minmax(0, 6fr);
    }

    .band:not(.on-page) .title {
      font-size: min(
        var(--fs-d-band),
        (100cqi - var(--sp-8)) * 10 / (11 * var(--word))
      );
    }

    /* Split: Why and What was hard on the left; the facts, then What it
       won't do, on the right, its heading level with What was hard. The
       story's parts are the grid's own items, so the rows space them
       (their margins), not the grid's gap. When the facts are the taller,
       the room they need opens under Why's paragraph (the flexible row),
       never between Why and its paragraph. */
    .split .zig {
      grid-template-rows: auto 1fr;
      row-gap: 0;
    }

    .split .story {
      display: contents;
    }

    .split .story > * {
      grid-column: 1;
    }

    .split .zig > :global(.facts) {
      grid-area: 1 / 2 / 3;
      margin-bottom: var(--sp-5);
    }

    .split .story > :nth-child(5) {
      grid-area: 3 / 2;
    }

    .split .story > :nth-child(6) {
      grid-area: 4 / 2;
    }
  }

  @media (max-width: 53.75rem) {
    .band {
      --band-r: var(--r-band-narrow);
    }
    .band-head,
    .on-page .band-top,
    .zig,
    .bare .zig {
      grid-template-columns: 1fr;
    }

    .on-page .band-top > :global(.facts) {
      margin-top: 0;
    }
  }

  @media (max-width: 32.5rem) {
    .on-page .title {
      margin-bottom: calc(var(--sp-5) - var(--sp-6));
    }
  }

  /* Forced colors drop the band's fill: a hairline in the text color
     keeps it a band. */
  @media (forced-colors: active) {
    .band {
      outline: var(--rule) solid CanvasText;
      outline-offset: calc(-1 * var(--rule));
    }
  }
</style>

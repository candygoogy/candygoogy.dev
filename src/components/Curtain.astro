---
// The home page's intro, when a session lands there first. A panel in the
// band's ink covers the page from the first paint (the page is fully
// rendered underneath).
// "candygoogy", the header's own wordmark scaled up and centred, rises
// letter by letter; then, with only a short beat after the last letter
// lands, the panel lifts away while the wordmark glides and shrinks into
// the header's wordmark, turning to page ink as the panel's edge passes
// it. The page's reveal starts with the lift, so the headline, the index
// and the band rise while the panel is still going: one movement.
//
// The head script in Base.astro decides whether it runs (html.intro-on):
// never without JS, never under reduced motion, only when home is the
// session's first page.
// Any click, key, wheel or tap fast-forwards it: whatever is left plays
// at twice the speed or more (450ms at most), so the
// panel still lifts and the wordmark still lands in the header. A finger
// that scrolls isn't a tap: the intro plays on at its own pace. If the page
// scrolls under it, the flying wordmark moves with the header's, so it
// lands wherever the header has gone (up and out, when it has left).
import { site } from "../data/site";
---

<div class="curtain" aria-hidden="true">
  <div class="panel"></div>
  <div class="ride">
    <p class="fly">
      {[...site.name].map((ch) => (
        <span class="l">
          <span>{ch}</span>
        </span>
      ))}
    </p>
  </div>
</div>

<script>
  const root = document.documentElement;
  // The site's curves (--ease-out and --ease-in-out in tokens.css).
  const token = (name: string, fallback: string) =>
    getComputedStyle(root).getPropertyValue(name).trim() || fallback;
  const OUT = token("--ease-out", "ease-out");
  const INOUT = token("--ease-in-out", "ease-in-out");
  const curtain = document.querySelector<HTMLElement>(".curtain");

  if (curtain && root.classList.contains("intro-on")) {
    const panel = curtain.querySelector<HTMLElement>(".panel");
    const ride = curtain.querySelector<HTMLElement>(".ride");
    const fly = curtain.querySelector<HTMLElement>(".fly");
    const brand = document.querySelector<HTMLElement>(".top .brand");
    const animations: Animation[] = [];
    let done = false;
    let skipped = false;
    // The last letter starts at 330ms and has visually landed by ~580ms
    // (the curve is front-loaded), so the lift starts right after. The
    // glide, the last thing moving, ends at end (lift + 40 + liftDur).
    const t = { lift: 580, liftDur: 640, end: 1260 };
    let liftTimer = 0;
    let endTimer = 0;

    // The flying wordmark rides with the header's: .ride is shifted by how
    // far the header wordmark has moved since start() measured it. Wide,
    // that's the scroll (the header is in the page); on phones the header
    // stays put and slides away on its own 250ms transition after the
    // scroll, so once the page scrolls this reads where it really is,
    // once a frame, until the curtain goes.
    let brandTop = 0;
    let riding = false;
    const follow = () => {
      if (done || !ride || !brand) return;
      const dy = brand.getBoundingClientRect().top - brandTop;
      ride.style.setProperty("--dy", `${dy}px`);
      requestAnimationFrame(follow);
    };
    const onScroll = () => {
      if (riding) return;
      riding = true;
      requestAnimationFrame(follow);
    };
    // A scroll while the intro waits for the font: on phones the header
    // may still be sliding when start() measures it, so the ride follows
    // from the start instead of waiting for a scroll that may not come.
    let scrolledEarly = false;
    const early = () => (scrolledEarly = true);
    addEventListener("scroll", early, { passive: true, once: true });

    const release = () => {
      if (!root.classList.contains("intro-hold")) return;
      root.classList.remove("intro-hold");
      window.dispatchEvent(new Event("intro:release"));
    };

    const finish = () => {
      if (done) return;
      done = true;
      for (const a of animations) a.cancel();
      release();
      curtain.remove();
      root.classList.remove("intro-on");
      for (const [t, f] of skips) removeEventListener(t, f, true);
      removeEventListener("scroll", onScroll);
      removeEventListener("scroll", early);
    };

    // Plays the rest at 2x, or faster if 2x would take over 450ms. The
    // animations all started together, so one clock gives where they are:
    // the one that ends last, whose time runs for the whole intro (one that
    // has ended stops at its end). The lift's timer is brought forward to
    // match, so the page still rises with the lift, and the curtain goes
    // when the last one ends.
    const endOf = (a: Animation) =>
      Number(a.effect?.getComputedTiming().endTime ?? 0);
    const hurry = () => {
      const clock = animations.reduce((a, b) => (endOf(b) > endOf(a) ? b : a));
      const at = Number(clock.currentTime ?? 0);
      const rate = Math.max(2, (t.end - at) / 450);
      for (const a of animations) a.updatePlaybackRate(rate);
      window.clearTimeout(liftTimer);
      window.clearTimeout(endTimer);
      if (at < t.lift) {
        liftTimer = window.setTimeout(release, (t.lift - at) / rate);
      } else release();
      // finish() cancels them all; nothing is left to wait for then. The
      // timer is the fallback if a finished promise never settles.
      Promise.all(animations.map((a) => a.finished)).then(finish, () => {});
      endTimer = window.setTimeout(finish, (t.end - at) / rate + 100);
    };

    // Before the intro has started (it waits briefly for the font), start()
    // sees the flag and hurries from the beginning.
    function skip() {
      if (done || skipped) return;
      skipped = true;
      if (animations.length) hurry();
    }

    const start = () => {
      if (done || !panel || !fly || !brand) return finish();
      // The wordmark's text box (on phones the link spans the whole row).
      const range = document.createRange();
      range.selectNodeContents(brand);
      const b = range.getBoundingClientRect();
      // Measured where the page is now (a restored scroll included); the
      // ride offsets from here.
      brandTop = brand.getBoundingClientRect().top;
      addEventListener("scroll", onScroll, { passive: true });
      removeEventListener("scroll", early);
      if (scrolledEarly) onScroll();
      const W = innerWidth;
      const H = innerHeight;

      // Big state: the header wordmark scaled up and centred. Wider on
      // phones so it still reads, never wider than the screen.
      const share = W < 600 ? 0.78 : 0.62;
      const scale = Math.min((W * share) / b.width, 7);
      const bigX = (W - b.width * scale) / 2;
      const bigY = (H - b.height * scale) / 2;
      fly.style.translate = `${bigX}px ${bigY}px`;
      fly.style.scale = String(scale);
      fly.style.opacity = "1";

      const ink = getComputedStyle(root).getPropertyValue("--ink").trim();

      // 1. Letters rise out of their clip, 30ms apart, fading up as they go.
      fly.querySelectorAll<HTMLElement>(".l > span").forEach((ch, i) => {
        animations.push(
          ch.animate(
            [
              { transform: "translateY(110%)", opacity: 0 },
              { opacity: 1, offset: 0.6 },
              { transform: "none", opacity: 1 },
            ],
            { duration: 620, delay: 60 + i * 30, easing: OUT, fill: "both" },
          ),
        );
      });

      // 2. The panel lifts away, its bottom edge travelling up.
      animations.push(
        panel.animate(
          [{ clipPath: "inset(0 0 0 0)" }, { clipPath: "inset(0 0 100% 0)" }],
          { duration: t.liftDur, delay: t.lift, easing: INOUT, fill: "both" },
        ),
      );

      // 3. The wordmark glides home. Scale leads the move a little, so it
      //    reads as settling rather than sliding.
      animations.push(
        fly.animate([{ scale: String(scale) }, { scale: "1" }], {
          duration: t.liftDur - 60,
          delay: t.lift,
          easing: INOUT,
          fill: "both",
        }),
        fly.animate(
          [
            { translate: `${bigX}px ${bigY}px` },
            { translate: `${b.left}px ${b.top}px` },
          ],
          {
            duration: t.liftDur,
            delay: t.lift + 40,
            easing: INOUT,
            fill: "both",
          },
        ),
      );

      // 4. Its colour turns to page ink as the panel's edge passes the
      //    header: find when the lift's edge reaches the wordmark's bottom
      //    (smootherstep stands in for the ease-in-out curve), then
      //    crossfade over 120ms around that moment.
      let pass = 0.9;
      for (let k = 0; k <= 100; k++) {
        const p = k / 100;
        const eased = p * p * p * (p * (6 * p - 15) + 10);
        if (H * (1 - eased) <= b.bottom + 4) {
          pass = p;
          break;
        }
      }
      animations.push(
        fly.animate([{ color: getComputedStyle(fly).color }, { color: ink }], {
          duration: 120,
          delay: t.lift + t.liftDur * pass - 60,
          easing: "linear",
          fill: "both",
        }),
      );

      // 5. The page rises as the panel starts to lift: the same reveals as
      //    a normal load (with their group delays halved while the intro
      //    is on, motion.css), overlapping the lift instead of following it.
      liftTimer = window.setTimeout(release, t.lift);
      endTimer = window.setTimeout(finish, t.end + 20);
      if (skipped) hurry();
    };

    // A mouse or pen skips as it presses. A finger skips only on a tap:
    // when it scrolls instead, the browser cancels the pointer and no
    // pointerup comes, so a scroll on a phone doesn't cut the intro short.
    const press = (e: PointerEvent) => {
      if ((e.pointerType === "touch") === (e.type === "pointerup")) skip();
    };
    const skips: [string, EventListener][] = [
      ["pointerdown", press as EventListener],
      ["pointerup", press as EventListener],
      ["keydown", skip],
      ["wheel", skip],
    ];
    for (const [t, f] of skips) {
      addEventListener(t, f, { capture: true, passive: true });
    }
    // Measure with the real font, but don't wait long for it.
    Promise.race([
      document.fonts.ready,
      new Promise((r) => setTimeout(r, 400)),
    ]).then(() => requestAnimationFrame(start));
  }
</script>

<style>
  .curtain {
    display: none;
  }

  /* Only when the head script chose to run it. */
  :global(html.intro-on) .curtain {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    /* Failsafe: gone by 2.6s even if the script never runs. */
    animation: gone 1ms linear 2600ms forwards;
  }

  /* The real header wordmark waits under the flying one (and comes back
     on its own at 2.6s if the script never runs). */
  :global(html.intro-on .top .brand) {
    visibility: hidden;
    animation: shown 1ms linear 2600ms forwards;
  }

  /* Phones: the nav is its own row under the wordmark, right in the
     wordmark's glide path, so it waits out the intro and fades in after
     (on its own at 2.6s if the script never runs). */
  @media (max-width: 32.5rem) {
    :global(.top nav) {
      transition: opacity 300ms var(--ease-out);
    }

    :global(html.intro-on .top nav) {
      opacity: 0;
      animation: shown-nav 1ms linear 2600ms forwards;
    }
  }

  @keyframes shown-nav {
    to {
      opacity: 1;
    }
  }

  @keyframes gone {
    to {
      visibility: hidden;
    }
  }

  @keyframes shown {
    to {
      visibility: visible;
    }
  }

  .panel {
    position: absolute;
    inset: 0;
    background: var(--band);
  }

  /* Carries the wordmark with the header when the page scrolls under it
     (--dy, set by the script), apart from the glide on .fly itself. */
  .ride {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateY(var(--dy, 0px));
  }

  /* The header wordmark's exact type, placed by the script. */
  .fly {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    opacity: 0;
    transform-origin: 0 0;
    color: var(--band-ink);
    font: var(--fw-heavy) 1.125rem / 1 var(--ff-text);
    letter-spacing: var(--ls-wordmark);
    white-space: nowrap;
  }

  /* Room below for the y's and g's tails (about 0.06em past the box at
     this line height), and no more: a deeper clip would show the tops of
     the d's before the rise. */
  .l {
    display: inline-block;
    clip-path: inset(-0.05em -0.06em -0.12em -0.06em);
  }

  .l > span {
    display: inline-block;
  }
</style>

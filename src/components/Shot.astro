---
// One screenshot, the same in both themes (its light version: the dark
// one shouted inside the dark band). Lazy unless it's on a page's first
// screen, where it loads at high priority. With a phone crop, narrow
// screens get the crop instead (art direction), so the detail stays
// readable instead of shrinking the whole window to a texture.
import type { ImageMetadata } from "astro";
import { getImage, Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  phone?: ImageMetadata | undefined;
  eager?: boolean;
}

const { src, alt, sizes, phone, eager = false } = Astro.props;
const loading = eager
  ? ({ loading: "eager", fetchpriority: "high" } as const)
  : ({ loading: "lazy" } as const);
const formats = ["avif", "webp"] as const;
const widths = [480, 800, 1200, 1400];

// The same breakpoint as the layout's phone styles (32.5rem).
const PHONE = "(max-width: 32.5rem)";

// With a crop: the crop under PHONE, then the full shot, each in AVIF and
// WebP, with a PNG <img> for old browsers. Each source carries its own
// size, so the page reserves the right height on every screen.
const sources = [];
if (phone) {
  for (const [image, w, media] of [
    [phone, [phone.width], PHONE],
    [src, widths.filter((x) => x <= src.width), undefined],
  ] as const) {
    for (const format of formats) {
      const img = await getImage({ src: image, format, widths: [...w] });
      sources.push({
        media,
        type: `image/${format}`,
        srcset: img.srcSet.attribute,
        width: image.width,
        height: image.height,
      });
    }
  }
}
const fallback = phone
  ? await getImage({ src, format: "png", widths })
  : undefined;
---

{phone && fallback ? (
  <picture>
    {sources.map((s) => (
      <source
        media={s.media}
        type={s.type}
        srcset={s.srcset}
        sizes={sizes}
        width={s.width}
        height={s.height}
      />
    ))}
    <img
      class="shot"
      src={fallback.src}
      srcset={fallback.srcSet.attribute}
      sizes={sizes}
      alt={alt}
      {...loading}
      decoding="async"
    />
  </picture>
) : (
  <Picture
    src={src}
    class="shot"
    alt={alt}
    sizes={sizes}
    formats={[...formats]}
    widths={widths}
    {...loading}
    decoding="async"
  />
)}

---
import type { ComponentProps } from "astro/types";
import type { CollectionEntry } from "astro:content";
import { site } from "../data/site";
import Rows, { type Row } from "./Rows.astro";

// Projects as text rows, in the order given: the home page's shortlist
// and /projects share one row shape. The list itself (its id, heading,
// aliases, row level) is the page's, passed on to Rows. The projects a
// shortlist leaves out (more) close it with one row, linking to them all.
type Props = {
  projects: CollectionEntry<"projects">[];
  more?: CollectionEntry<"projects">[];
} & Omit<ComponentProps<typeof Rows>, "rows" | "more">;

const { projects, more = [], ...list } = Astro.props;
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
const kind = { side: "Side project", website: "Website", product: "Product" };

// The row's one link, named by where it goes: a product's own page (its
// address on this site); else a live site; otherwise the source.
const link = ({ id, data }: CollectionEntry<"projects">): Row["link"] =>
  data.kind === "product"
    ? { href: `/${id}`, kind: "page", label: `${host(site.url)}/${id}` }
    : data.links.live
      ? { href: data.links.live, kind: "live", label: host(data.links.live) }
      : data.links.source
        ? { href: data.links.source, kind: "source" }
        : undefined;

// What I did (the role, or the license for my own code), then the stack.
const credit = ({ data }: CollectionEntry<"projects">) =>
  data.role
    ? `${data.role}.`
    : data.license
      ? `Open source, ${data.license}.`
      : "";

const rows: Row[] = projects.map((p) => {
  const go = link(p);
  return {
    id: p.id,
    name: p.data.name,
    kind: kind[p.data.kind],
    year: p.data.date.getUTCFullYear(),
    summary: p.data.summary,
    ...(go ? { link: go } : {}),
    // A product's title carries its view-transition name to its page.
    ...(p.data.kind === "product" ? { vt: p.id } : {}),
    credit: credit(p),
    stack: p.data.stack,
  };
});
// The closing row's line: the kinds of the projects it stands for, as
// categories (plural even for one), so it stays true as the list changes,
// e.g. "Side projects, and websites I’ve built for others."
const kinds = {
  product: "products",
  side: "side projects",
  website: "websites I’ve built for others",
} as const;
const line = (left: CollectionEntry<"projects">[]) => {
  const parts = (["product", "side", "website"] as const)
    .filter((k) => left.some((p) => p.data.kind === k))
    .map((k) => kinds[k]);
  const text =
    parts.length > 1
      ? `${parts.slice(0, -1).join(", ")}, and ${parts.at(-1)}`
      : (parts[0] ?? "");
  return `${text.charAt(0).toUpperCase()}${text.slice(1)}.`;
};
---

<Rows
  {...list}
  rows={rows}
  more={{
    count: more.length,
    line: line(more),
    href: "/projects",
    label: `${host(site.url)}/projects`,
  }}
/>

---
import type { CollectionEntry } from "astro:content";
import Rows, { type Row } from "./Rows.astro";

// Everything made besides the products, in the hero index's order: side
// projects and client sites share one list and one row shape.
interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
const host = (url: string) => new URL(url).hostname.replace(/^www\./, "");
const kind = { side: "Side project", website: "Website", product: "Product" };

// The row's one link: a product's own page; else a live site; otherwise
// the source.
const link = ({ id, data }: CollectionEntry<"projects">): Row["link"] =>
  data.kind === "product"
    ? { href: `/${id}`, kind: "page" }
    : data.links.live
      ? { href: data.links.live, kind: "live", label: host(data.links.live) }
      : data.links.source
        ? { href: data.links.source, kind: "source" }
        : undefined;

// What I did (the role, or the license for my own code), then the stack.
const credit = ({ data }: CollectionEntry<"projects">) =>
  data.role
    ? `${data.role}.`
    : data.license
      ? `Open source, ${data.license}.`
      : "";

const rows: Row[] = projects.map((p) => {
  const go = link(p);
  return {
    id: p.id,
    name: p.data.name,
    kind: kind[p.data.kind],
    year: p.data.date.getUTCFullYear(),
    summary: p.data.summary,
    ...(go ? { link: go } : {}),
    // A product's title carries its view-transition name to its page.
    ...(p.data.kind === "product" ? { vt: p.id } : {}),
    credit: credit(p),
    stack: p.data.stack,
  };
});
---

<Rows
  id="projects"
  title="More things I’ve made"
  rows={rows}
  aliases={["websites", "side-projects"]}
/>

---
import { site } from "../data/site";
import { builtOn, commit, dirty, shortCommit } from "../lib/build";

interface Props {
  backToTop?: boolean;
}

const { backToTop = true } = Astro.props;

// The page's own link is marked current, as in the header nav.
const path = Astro.url.pathname.replace(/\.html$/, "");
const current = (href: string) => (path === href ? "page" : undefined);
---

<footer class="wrap">
  <div class="inner rv-line" data-line="line">
    <p class="notes">
      <span>
        © {new Date().getFullYear()} {site.name}
      </span>
      <span>
        <a href="/colophon#privacy">No trackers, no cookies</a>
      </span>
      <span class="stamp">
        Built <time datetime={builtOn.iso}>{builtOn.label}</time>
        {commit && (
          <>
            {" from "}
            <a
              href={`${site.source}/commit/${commit}`}
              aria-label={`commit ${shortCommit}${dirty ? ", with uncommitted changes" : ""}`}
            >
              {shortCommit}
            </a>
          </>
        )}
      </span>
    </p>
    <a href="/colophon" aria-current={current("/colophon")}>
      Colophon
    </a>
    <a href="/uses" aria-current={current("/uses")}>
      Uses
    </a>
    {backToTop && <a href="#top">Back to top</a>}
    <!-- Paper only (print.css). -->
    <p class="printed">
      Printed from candygoogy.dev{commit && `, build ${commit.slice(0, 7)}`}
    </p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--sp-8);
  }

  /* Grouped by kind: the notes on the left, the links on the right, one
     gap throughout, on one baseline. */
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-6);
    /* The row sits in the middle of its band. */
    padding-block: var(--sp-6);
    font-size: var(--fs-sm);
    color: var(--soft);
  }

  /* The notes (©, no trackers, the build stamp) take the row's free
     space and wrap within it: where they don't fit on one line the stamp
     drops to its own, and the links stay on the right, on the first
     line's baseline. (A zero basis: the row breaks on the notes' widest
     span, not on all three side by side.) Wrapped notes stand 24px
     apart, so the touch targets of the claim's link and the stamp's
     never overlap. */
  .notes {
    display: flex;
    font-variant-numeric: tabular-nums;
    flex: 1 1 0;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-5) var(--sp-6);
    margin: 0;
  }

  /* Each note stays whole. */
  .notes > span {
    white-space: nowrap;
  }

  /* Narrower, the notes take the first row and the links the next. */
  @media (max-width: 53.75rem) {
    .notes {
      flex-basis: 100%;
    }
  }

  .inner a[aria-current="page"] {
    color: var(--ink);
  }

  /* Each link has a touch target at least 44px each way, laid over the
     line without changing it; the rows (below) and the links stand far
     enough apart that targets never overlap. */
  .inner a {
    position: relative;
  }

  .inner a::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: max(100%, 44px);
    height: 44px;
    translate: -50% -50%;
  }

  /* Narrower, the notes and the links wrap onto rows: 24px between them
     keeps the touch targets apart. */
  @media (max-width: 53.75rem) {
    .inner {
      row-gap: var(--sp-5);
    }
  }

  .printed {
    display: none;
    margin: 0;
  }

  /* Phones: the © and the claim side by side (the claim wraps under the
     © where they don't fit, 24px down), then the links under them on one
     row, all on the page's left edge. That's the markup's order, so Tab
     goes the way the page reads. The build stamp is left out: the
     colophon's Source row states the same build, so the footer stays
     short. */
  @media (max-width: 32.5rem) {
    footer {
      margin-top: var(--sp-7);
    }

    .inner {
      padding-block: var(--sp-5);
    }

    .notes {
      column-gap: var(--sp-5);
    }

    .stamp {
      display: none;
    }
  }

  /* Forced colors: the page you're on reads as text, as its ink does. */
  @media (forced-colors: active) {
    .inner a[aria-current="page"] {
      color: CanvasText;
    }
  }
</style>

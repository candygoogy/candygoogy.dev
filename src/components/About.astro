---
import gaijinLogo from "../assets/logos/gaijin-entertainment.svg";
// Prepared at 2x (36px) with a clean circular alpha; served as is, not
// resampled again, so the edge stays free of halos.
import sielLogo from "../assets/logos/siel-eolie.webp";
import {
  about,
  fixes as allFixes,
  fixesTitle,
  orgs,
  site,
  skills,
  work,
} from "../data/site";
import { checkFixes } from "../lib/fixes";
import { github } from "../lib/github";
import Heatmap from "./Heatmap.astro";
import Section from "./Section.astro";

const days = github.contributions?.days ?? [];
// Throws, and so stops the build, on a fix that isn't a pull request on
// someone else's project.
const fixes = checkFixes(allFixes);
const fmtMonth = new Intl.DateTimeFormat("en-US", {
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const logos = { siel: sielLogo, gaijin: gaijinLogo };
// Display size: Siel's round mark 18px, Gaijin's white wordmark 14px tall.
const logoSize = (org: keyof typeof logos) => {
  const h = org === "gaijin" ? 16 : 18;
  const { width, height } = logos[org];
  return { width: Math.round((width / height) * h), height: h };
};

// The timeline's groups: consecutive items with the same employer, headed
// by its chip; items without one form Education. Each role shows the year
// it started, level with its dot.
type Group = {
  org: keyof typeof orgs | undefined;
  items: typeof work;
};
const groups: Group[] = [];
for (const item of work) {
  const last = groups.at(-1);
  if (last && last.org === item.org) last.items.push(item);
  else groups.push({ org: item.org, items: [item] });
}
// "Mar 2024 to Dec 2025": the start goes in a <time>, the rest follows it.
const dates = (when: string): [string, string] => {
  const at = when.indexOf(" to ");
  return at < 0 ? [when, ""] : [when.slice(0, at), when.slice(at)];
};
---

<Section id="about" title="About">
  <div class="intro">
    <p class="lead rv">{about.background}</p>
    <p class="lead rv" data-i="1">
      {about.away}
    </p>
  </div>

  <!-- The timeline: one line through every role's dot, from the job going
       on now (its tail above keeps flowing) down to the first school (its
       tail below is still). The line, dots and tails are drawing only.
       Its motion is scripts/motion/about.ts. -->
  <div class="tl" data-motion="about">
    <div class="line" aria-hidden="true">
      <span class="ink"></span>
      <span class="tail up">
        <span class="flow"></span>
      </span>
      <span class="tail down"></span>
    </div>
    <ol class="groups">
      {groups.map((g) => (
        <li class="group">
          <div class="body">
            <h3 class="rv" data-i="1">
              {g.org ? (
                <a
                  class="org"
                  href={orgs[g.org].url}
                  data-preview={`pv-${g.org}`}
                >
                  <span class:list={["chip", `chip-${g.org}`]}>
                    <img
                      src={logos[g.org].src}
                      alt=""
                      width={logoSize(g.org).width}
                      height={logoSize(g.org).height}
                      decoding="async"
                    />
                  </span>
                  {orgs[g.org].name}
                </a>
              ) : (
                "Education"
              )}
            </h3>
            <ol class="roles">
              {g.items.map((item, i) => {
                const [from, rest] = dates(item.when ?? "");
                return (
                  <li
                    class:list={["role", "rv", { current: item.current }]}
                    data-i={i + 2}
                  >
                    {item.datetime && (
                      <p class="year" aria-hidden="true">
                        {item.datetime.slice(0, 4)}
                      </p>
                    )}
                    <span class="dot" aria-hidden="true">
                      <span></span>
                    </span>
                    <h4>{item.title}</h4>
                    {item.when && (
                      <p class="meta">
                        {item.type && `${item.type}, `}
                        {item.datetime ? (
                          <time datetime={item.datetime}>{from}</time>
                        ) : (
                          from
                        )}
                        {rest}
                      </p>
                    )}
                    {item.detail && <p class="detail">{item.detail}</p>}
                  </li>
                );
              })}
            </ol>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Section>

<!-- Skills span the page as one row of four groups,
     so the lower half of About doesn't sit beside an empty column. -->
<section class="skills-row" aria-labelledby="skills-title">
  <h3 id="skills-title" class="rv">
    Skills
  </h3>
  <dl class="skills">
    {skills.map((s, i) => (
      <div class="rv" data-i={i + 1}>
        <dt>{s.group}</dt>
        {/* Lines break between skills, never inside one ("Claude Code"). */}
        <dd>
          {s.items.split(", ").map((item, j) => (
            <>
              {j > 0 && ", "}
              <span class="nobr">{item}</span>
            </>
          ))}
        </dd>
      </div>
    ))}
  </dl>
</section>

{
  /* The heatmap is a feature, so it gets the full content width below the
     About columns instead of a narrow slot inside them. The fixes follow
     it, and stay under the heading when there's no heatmap to show. */
  (days.length > 0 || fixes.length > 0) && (
    <section
      class:list={["github", { "heat-draw": days.length > 0 }]}
      aria-labelledby="github-title"
    >
      <h3 id="github-title">On GitHub</h3>
      {days.length > 0 && <Heatmap days={days} profile={site.github} />}
      {fixes.length > 0 && (
        <div class="fixes">
          <h4>{fixesTitle}</h4>
          <ol>
            {fixes.map((fix) => (
              <li>
                <h5>
                  <a href={fix.url}>{fix.project}</a>
                </h5>
                <p class="meta">
                  <time datetime={fix.merged}>
                    {fmtMonth.format(new Date(`${fix.merged}T00:00:00Z`))}
                  </time>
                </p>
                <p class="detail">{fix.line}</p>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  )
}

<style>
  /* A two-paragraph personal intro (background, then away from the
     computer) before the factual part. */
  .intro {
    display: grid;
    gap: var(--sp-4);
    margin-bottom: var(--sp-7);
  }

  .lead {
    max-width: var(--measure);
    font-size: var(--fs-lede);
  }

  /* The timeline, grouped by employer: a narrow column for each role's
     start year (none on phones), then the group's heading and its roles.
     The roles' dots sit in a 24px gutter on one line; the headings and
     role text start after the gutter. */
  .tl {
    --year: 5.5rem;
    --gut: 24px;
    --dot: 9px;
    /* One role title line, and the heading line above the first role. */
    --role-lh: 1.75rem;
    --head-lh: 2rem;
    position: relative;
  }

  .groups,
  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .groups {
    display: grid;
    gap: var(--sp-7);
  }

  .group {
    display: grid;
    grid-template-columns: var(--year) minmax(0, 1fr);
  }

  /* Each role's start year, in the column left of the line, level with
     its dot. */
  .year {
    position: absolute;
    top: 0;
    left: calc(-1 * var(--year));
    font-size: var(--fs-meta);
    line-height: var(--role-lh);
    color: var(--soft);
    font-variant-numeric: tabular-nums;
  }

  .body {
    grid-column: 2;
    min-width: 0;
  }

  /* The group's heading: the employer's chip, or "Education", level with
     the role text. */
  .body > h3 {
    display: flex;
    align-items: center;
    min-height: var(--head-lh);
    margin-bottom: var(--sp-3);
    padding-left: var(--gut);
    font: var(--fw-bold) var(--fs-lede) / var(--head-lh) var(--ff-text);
    letter-spacing: 0;
  }

  .roles {
    display: grid;
    gap: var(--sp-5);
  }

  .role {
    position: relative;
    padding-left: var(--gut);
  }

  /* A hairline ring on the line, level with the role's title; the job going
     on now is filled with ink. Without JS this is how they rest. */
  .dot {
    position: absolute;
    z-index: 1;
    top: calc(var(--role-lh) / 2 - var(--dot) / 2);
    left: calc(var(--gut) / 2 - var(--dot) / 2);
    width: var(--dot);
    height: var(--dot);
    border: var(--rule) solid var(--soft);
    border-radius: 50%;
    background: var(--bg);
  }

  .dot > span {
    position: absolute;
    inset: calc(-1 * var(--rule));
    border-radius: 50%;
    background: var(--ink);
    transform: scale(0);
  }

  .current .dot > span {
    transform: none;
  }

  /* Read by scrolling (the script, which sets .scrubbing once it has put
     every part where the scroll says): the ink follows, dots wait empty
     until the ink reaches them. Without the script the
     timeline simply shows complete. */
  @media (prefers-reduced-motion: no-preference) {
    .tl:global(.scrubbing) .role .dot > span {
      transform: scale(0);
    }

    .tl:global(.scrubbing) .role .dot:global(.on) > span {
      transform: none;
    }
  }

  .role h4 {
    font: var(--fw-bold) var(--fs-body) / var(--role-lh) var(--ff-text);
  }

  .meta {
    font-size: var(--fs-sm);
    color: var(--soft);
    font-variant-numeric: tabular-nums;
  }

  .detail {
    margin-top: var(--sp-1);
  }

  /* The line: a hairline track through the dots with its ink fill, and
     the two tails, two dots 10px apart, fading away from it. Until the
     script measures the dots, it starts and ends at CSS's best guess. */
  .line {
    position: absolute;
    top: var(
      --line-top,
      calc(var(--head-lh) + var(--sp-3) + var(--role-lh) / 2)
    );
    bottom: var(--line-bottom, 2.85rem);
    left: calc(var(--year) + var(--gut) / 2 - var(--rule) / 2);
    width: var(--rule);
    background: var(--line);
  }

  .ink {
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform-origin: top;
  }

  /* Two dots, so the top tail stays below the first group's heading. */
  .tail {
    position: absolute;
    left: -1px;
    width: 3px;
    height: 20px;
    overflow: hidden;
  }

  .tail.up {
    bottom: calc(100% + var(--dot) / 2 + 4px);
    mask-image: linear-gradient(to top, #000 20%, transparent);
  }

  .tail.down {
    top: calc(100% + var(--dot) / 2 + 4px);
    background: radial-gradient(circle, var(--soft) 1.1px, transparent 1.6px)
      center 0 / 3px 10px repeat-y;
    mask-image: linear-gradient(to bottom, #000 20%, transparent);
  }

  /* The top tail's dots, one step (10px) taller than the tail, so moving
     them down by one step loops seamlessly. */
  .flow {
    position: absolute;
    inset: -10px 0 0;
    background: radial-gradient(circle, var(--soft) 1.1px, transparent 1.6px)
      center 0 / 3px 10px repeat-y;
  }

  /* The job going on now: its tail keeps flowing toward its dot, one dot
     step every 1.5s, only while the timeline is on screen, never under
     reduced motion; without JS it stays still. */
  @media (prefers-reduced-motion: no-preference) {
    .flow {
      animation: tail-step 1.5s linear infinite paused;
    }

    .tl[data-live] .flow {
      animation-play-state: running;
    }
  }

  @keyframes tail-step {
    to {
      transform: translateY(10px);
    }
  }

  /* Phones: no year column, since the meta line under each title carries
     the dates; the line and dots run down the left edge. */
  @media (max-width: 32.5rem) {
    .tl {
      --year: 0px;
    }

    .group {
      grid-template-columns: minmax(0, 1fr);
    }

    .body {
      grid-column: 1;
    }

    .year {
      display: none;
    }
  }

  /* Logo chips: small, in the brand's own colors, beside the name. */
  /* Each employer is one mention chip: a hairline pill holding its logo
     and name, centred in the heading's 28px line, so it never grows it. */
  .org {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px 2px 3px;
    border: var(--rule) solid var(--chip-line);
    border-radius: var(--r-pill);
    /* 22px of text + 2px padding and a 1px border each side = the 28px
       line exactly. */
    line-height: 22px;
    white-space: nowrap;
    /* A link to the employer's site, styled as the chip: the text keeps
       its color, no underline or marker; the border darkens on hover and
       the focus ring follows the pill. */
    background: none;
    color: inherit;
    transition: border-color var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .org:hover {
      border-color: color-mix(in oklab, var(--ink) 45%, var(--bg));
    }
  }

  /* A 44px tall touch target, laid over the line without changing it. */
  .org::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 44px;
    translate: 0 -50%;
  }

  /* Closer than the site's 4px, so the ring clears the word before it. */
  .org:focus-visible {
    outline-offset: 2px;
    border-radius: var(--r-pill);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    vertical-align: middle;
  }

  /* Explicit heights: the base img rule (height: auto) would otherwise
     override the height attribute. */
  .chip :global(img) {
    display: block;
    width: auto;
    height: 18px;
  }

  /* Whole-pixel size (the mark is 133 x 77) so the white strokes stay as
     crisp as they can on the dark chip: a 28 x 16 image in a 36 x 20 chip. */
  .chip-gaijin :global(img) {
    width: 28px;
    height: 16px;
  }

  /* Gaijin's mark is white, so it always sits on a small dark chip. */
  .chip-gaijin {
    padding: 2px 4px;
    border-radius: 5px;
    background: #18181b;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--ink) 12%, transparent);
  }

  /* Skills and On GitHub are sibling subsections, each a heading over
     the full content width. */
  .skills-row {
    margin-top: var(--sp-9);
  }

  .skills-row > h3 {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-d-md);
    letter-spacing: var(--ls-d-sm);
  }

  .github {
    margin-top: var(--sp-8);
  }

  .github > h3 {
    margin-bottom: var(--sp-3);
    font-size: var(--fs-d-md);
    letter-spacing: var(--ls-d-sm);
  }

  /* The fixes, under the heatmap: a subheading like a skill group's, then
     each fix the way the timeline shows a role (the name, the month soft,
     the line), side by side while there's room. */
  .fixes {
    margin-top: var(--sp-7);
  }

  .fixes > h4 {
    margin-bottom: var(--sp-4);
    font-size: var(--fs-d-xs);
  }

  .fixes > ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-5) var(--sp-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fixes li {
    max-width: var(--measure);
  }

  .fixes h5 {
    margin: 0;
    font: var(--fw-bold) var(--fs-body) / var(--lh-body) var(--ff-text);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-6) var(--sp-7);
    margin: 0;
  }

  dt {
    margin-bottom: var(--sp-1);
    font: var(--fw-d-bold) var(--fs-d-xs) / var(--lh-tight) var(--ff-display);
  }

  /* Like paragraphs (base.css): no lone word on a list's last line. */
  dd {
    margin: 0;
    text-wrap: pretty;
  }

  @media (max-width: 53.75rem) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .fixes > ol {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 32.5rem) {
    .skills {
      grid-template-columns: 1fr;
    }
  }

  /* Forced colors (Windows Contrast themes) drop fills and gradients: the
     line, its ink and the filled dots take system colors, and the tails
     keep their dots in a system color. Gaijin's white mark keeps its dark
     tile, or it would vanish on a light theme. */
  @media (forced-colors: active) {
    .line {
      background: GrayText;
    }

    .ink,
    .dot > span {
      background: CanvasText;
    }

    .tail {
      forced-color-adjust: none;
    }

    .tail.down,
    .flow {
      background: radial-gradient(circle, GrayText 1.1px, transparent 1.6px)
        center 0 / 3px 10px repeat-y;
    }

    .chip-gaijin {
      forced-color-adjust: none;
    }
  }
</style>

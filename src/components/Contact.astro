---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import committedAvatar from "../assets/avatar.jpg";
import { DISCORD, GITHUB, TELEGRAM, X } from "../data/icons";
import { contact, site } from "../data/site";

// The avatar from the GitHub profile (scripts/avatar.mjs, gitignored), or
// the committed copy when the build couldn't fetch it.
const live = import.meta.glob<ImageMetadata>("../assets/avatar.live.jpg", {
  eager: true,
  import: "default",
});
const avatar = Object.values(live)[0] ?? committedAvatar;

// Two groups, split by the card's hairline: profiles to follow, then
// places to talk. The handle shows once, in the header; each row carries
// it in hidden text, so its link reads "GitHub, candygoogy, Open".
const groups = [
  [
    {
      label: "GitHub",
      handle: "candygoogy",
      action: "Open",
      href: site.github,
      path: GITHUB,
    },
    {
      label: "X",
      handle: "@candygoogy",
      action: "Open",
      href: site.x,
      path: X,
      // The X mark is square and open: drawn a touch larger (a cropped
      // box, same 18px slot) to match the round glyphs' weight.
      box: "1 1 22 22",
    },
  ],
  [
    {
      label: "Discord",
      handle: "candygoogy",
      action: "Message",
      href: site.discord,
      path: DISCORD,
    },
    {
      label: "Telegram",
      handle: "@candygoogy",
      action: "Message",
      href: site.telegram,
      path: TELEGRAM,
    },
  ],
];

// The question, split into words so its lines can rise in turn.
const words = contact.question.split(" ");
---

<!--
  The page's close: on the left, the question as a statement, its answer,
  and the email with Copy; on the right, a quiet card with the Discord
  status and every other way to reach candygoogy. The card is a raised
  surface in the page's own colors, not the band's ink (the band stays the
  one bold element). Its scripts (presence, the pill, Copy) are
  scripts/motion/contact.ts.
-->
<section
  id="contact"
  class="contact rv-line"
  aria-labelledby="contact-title"
  data-motion="contact"
>
  <h2 id="contact-title" class="visually-hidden">
    Contact
  </h2>
  <div class="say">
    <p class="statement line-title">
      {words.map((word, i) => (
        <>
          <span class="w">
            <span>{word}</span>
          </span>
          {i < words.length - 1 && " "}
        </>
      ))}
    </p>
    <p class="lead rv" style="--d: 360ms">
      {contact.lead}
    </p>
    <!-- One outline pill, two controls: the mailto link and Copy. The
         reveal is on the wrapper, so the pill's own transitions keep
         their timing. -->
    <div class="mail rv" style="--d: 460ms">
      <div class="pill">
        <a class="seg address" href={`mailto:${site.email}`}>
          <span class="fill" aria-hidden="true"></span>
          <span class="env" aria-hidden="true">
            {["out", "in"].map((part) => (
              <svg
                class={`line-icon env-${part}`}
                viewBox="0 0 24 24"
                width="18"
                height="18"
              >
                <rect x="2.75" y="4.75" width="18.5" height="14.5" rx="2.5" />
                <path class="flap" d="m3.5 6.5 8.5 6.5 8.5-6.5" />
              </svg>
            ))}
          </span>
          <span class="addr">{site.email}</span>
        </a>
        <button
          type="button"
          class="seg copy"
          data-copy={site.email}
          aria-label="Copy email address"
          aria-disabled="true"
        >
          <span class="fill" aria-hidden="true"></span>
          <span class="stack icons" aria-hidden="true">
            <svg
              class="line-icon glyph"
              viewBox="0 0 16 16"
              width="14"
              height="14"
            >
              <rect x="5.5" y="5.5" width="8" height="8" rx="1.75"></rect>
              <path d="M3.5 10.5h-.25A1.75 1.75 0 0 1 1.5 8.75v-5.5A1.75 1.75 0 0 1 3.25 1.5h5.5a1.75 1.75 0 0 1 1.75 1.75v.25"></path>
            </svg>
            <svg
              class="line-icon check"
              viewBox="0 0 16 16"
              width="14"
              height="14"
            >
              <path d="M3 8.5 6.5 12 13 4.5" pathLength="1"></path>
            </svg>
          </span>
          <span class="stack copy-label" aria-hidden="true">
            <span class="idle">Copy</span>
            <span class="done">Copied</span>
          </span>
        </button>
      </div>
      <span class="visually-hidden" role="status" data-copy-status></span>
    </div>
  </div>

  <div class="card rv" style="--d: 200ms">
    <div class="who">
      <Picture
        class="avatar"
        src={avatar}
        alt=""
        width={52}
        height={52}
        densities={[1, 2]}
        formats={["avif", "webp"]}
        loading="eager"
      />
      <div>
        <p class="name">{site.name}</p>
        <p class="presence" data-presence hidden>
          <span class="dot" aria-hidden="true"></span>
          <!-- The longest state's line, unseen, holds the line's size, so a
               change of state never shifts it. -->
          <span class="phrase">
            <span>
              <span class="state"></span> on Discord
            </span>
            <span class="ghost" aria-hidden="true">
              Do not disturb on Discord
            </span>
          </span>
        </p>
      </div>
    </div>
    {groups.map((group, g) => (
      <ul class="rows">
        {group.map((l, i) => (
          <li class="rv" style={`--d: 320ms; --i: ${g * 2 + i}`}>
            <a class="row" href={l.href}>
              <svg
                viewBox={l.box ?? "0 0 24 24"}
                width="18"
                height="18"
                aria-hidden="true"
              >
                <path d={l.path} />
              </svg>
              <span class="label">
                {l.label}
                <span class="visually-hidden">, {l.handle}, </span>
              </span>
              <span class="act">{l.action}</span>
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  /* The 7:5 grid: statement on the left, card on the right, both resting
     on the same bottom line. */
  .contact {
    /* The card's surface, shared by the email pill: one material. */
    --surface: color-mix(in oklab, var(--line) 45%, var(--bg));
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--sp-8) var(--gap-hero);
    align-items: end;
    margin-top: var(--space-section);
    padding-top: var(--sp-7);
    padding-bottom: var(--sp-6);
  }

  /* A step below the hero headline, so the page keeps one biggest line. */
  .statement {
    max-width: 18ch;
    font: var(--fw-bold) clamp(2rem, 1rem + 2.6vw, 3.5rem) / 1.04
      var(--ff-display);
    letter-spacing: var(--ls-hero);
    color: var(--ink);
    text-wrap: balance;
  }

  .statement .w {
    display: inline-block;
    clip-path: inset(-0.06em -0.08em -0.14em -0.08em);
  }

  .statement .w > span {
    display: inline-block;
  }

  /* The answer reads in ink, sized to break after "myself,". */
  .lead {
    max-width: 26.5em;
    margin-top: var(--sp-5);
    font-size: var(--fs-lede);
    color: var(--ink);
    text-wrap: pretty;
  }

  @media (max-width: 32.5rem) {
    .lead {
      text-wrap: balance;
    }
  }

  /* The email: one pill on the card's own surface, inside a hairline,
     holding two real controls, the address and Copy, behind a hairline
     divider. Both are set in the text face on one baseline. Each segment
     has its own hover fill, focus ring and press. Without JS, Copy is
     hidden and the pill closes after the address. */
  /* A flex box, not a line: an inline pill on a text line would sit on
     its baseline and leave the descender's gap under it. */
  .mail {
    display: flex;
    margin-top: var(--sp-6);
  }

  .pill {
    display: inline-flex;
    align-items: stretch;
    max-width: 100%;
    overflow: clip;
    border: var(--rule) solid var(--chip-line);
    border-radius: var(--r-pill);
    background: var(--surface);
    transition:
      border-color var(--dur-ui) var(--ease-out),
      transform 120ms var(--ease-ui);
  }

  /* On hover the border leans toward the accent. */
  @media (hover: hover) and (pointer: fine) {
    .pill:has(.seg:hover) {
      border-color: color-mix(in oklab, var(--acc) 45%, var(--chip-line));
    }
  }

  /* Press: the whole pill, so the segments never part at the divider. */
  @media (prefers-reduced-motion: no-preference) {
    .pill:has(.seg:active) {
      transform: scale(0.97);
    }
  }

  /* Each segment clips its own fill (a fill waiting off one segment's
     edge would otherwise show over its neighbour). */
  .seg {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    /* 48px with the pill's hairline. */
    min-height: calc(3rem - 2 * var(--rule));
    border: 0;
    background: none;
    color: var(--ink);
    font: var(--fw-medium) var(--fs-body) / 1 var(--ff-text);
    cursor: pointer;
  }

  /* The fill: a soft accent layer behind the text, waiting just off its
     left edge (the script moves it for the mouse); the text stays ink
     (13.5:1 light, 12.6:1 dark). Without the script hover is a plain
     fill; a touch fills while pressed. */
  .fill {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in oklab, var(--acc) var(--mark-mix), transparent);
    transform: translate(var(--fx, -101%), var(--fy, 0%));
    pointer-events: none;
  }

  .seg:not(.sweeps):hover .fill,
  .seg:active:not([data-sweep]) .fill,
  .seg:focus-visible .fill,
  .seg[data-sweep="in"] .fill {
    transform: none;
  }

  /* In over 320ms; out quicker, 240ms, on the in-out curve. Each retargets
     from wherever the fill is. */
  .seg[data-sweep="in"] .fill {
    transition: transform 320ms var(--ease-out);
  }

  .seg[data-sweep="out"] .fill {
    transition: transform 240ms var(--ease-in-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .seg .fill {
      transition: none !important;
    }
  }

  /* The focus ring sits inside each segment, on its own rounded end. */
  .seg:focus-visible {
    outline-offset: -4px;
  }

  .address {
    padding: 0 20px;
    border-radius: var(--r-pill);
    background: none;
    font-weight: 600;
  }

  :global(.js) .address {
    border-radius: var(--r-pill) 0 0 var(--r-pill);
  }

  .addr {
    white-space: nowrap;
  }

  .line-icon {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The envelope: two copies in one cell. The second waits unseen for
     the send animation (see the script). */
  .env {
    display: inline-grid;
    flex: none;
  }

  /* Visible overflow: the opened flap reaches above the glyph's box. */
  .env > svg {
    grid-area: 1 / 1;
    overflow: visible;
  }

  .env-in {
    opacity: 0;
  }

  .flap {
    transform-box: fill-box;
    transform-origin: 50% 0;
  }

  /* Copy: the pill's right segment, behind a hairline divider. Hidden
     without JS (the clipboard needs it). */
  .copy {
    display: none;
    padding: 0 var(--sp-4);
    border-left: var(--rule) solid var(--chip-line);
    border-radius: 0 var(--r-pill) var(--r-pill) 0;
  }

  :global(.js) .copy {
    display: inline-flex;
  }

  /* Until its script is ready, Copy rests as it looks but takes no hover
     or press (scripts/motion/contact.ts enables it). */
  .copy[aria-disabled="true"] {
    cursor: default;
    pointer-events: none;
  }

  /* The icon and the label each keep both states in one grid cell, sized
     to the larger ("Copied"), so the pill never resizes. Which one shows
     is plain CSS, at once; the motion between them (the words through
     their cell, the check drawing in) is scripts/motion/contact.ts. */
  .stack {
    display: inline-grid;
  }

  .stack > * {
    grid-area: 1 / 1;
  }

  /* The words move through their cell, clipped above and below. */
  .copy-label {
    clip-path: inset(0 -0.25em);
  }

  .copy .glyph {
    stroke-width: 1.5;
  }

  .check {
    stroke-width: 2;
  }

  /* The check is drawn along its length (pathLength 1). */
  .check path {
    stroke-dasharray: 1;
  }

  .check,
  .copy-label .done,
  .copy[data-state="done"] .glyph,
  .copy[data-state="done"] .copy-label .idle {
    opacity: 0;
  }

  .copy[data-state="done"] .check,
  .copy[data-state="done"] .copy-label .done {
    opacity: 1;
  }

  /* Phones: the pill takes the column's width, Copy still inside it. */
  @media (max-width: 32.5rem) {
    .pill {
      display: flex;
      width: 100%;
    }

    .address {
      flex: 1 1 auto;
      min-width: 0;
      padding: 0 var(--sp-4);
    }
  }

  /* Narrow phones: the address a step smaller and Copy an icon (its name
     stays its accessible label), so the pill fits on one line with room
     to spare. */
  @media (max-width: 25.5rem) {
    .address {
      gap: var(--sp-2);
      font-size: var(--fs-meta);
    }

    .copy {
      padding: 0 var(--sp-4);
    }

    .copy-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* The card: a quiet raised surface in the page's own colors. --inset is
     the rows' inner padding: the avatar, the row icons and the divider all
     start on it, and the divider ends where "Open"/"Message" end. */
  .card {
    --inset: var(--sp-3);
    padding: var(--sp-5);
    border: var(--rule) solid var(--line);
    border-radius: 20px;
    background: var(--surface);
  }

  .who {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding: 0 var(--inset) var(--sp-4);
  }

  .who :global(.avatar) {
    display: block;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 14px;
    object-fit: cover;
    /* A 1px ring in the rule color seats the artwork's white ground on
       the card; drawn inside the image, on its own radius. */
    outline: var(--rule) solid var(--line);
    outline-offset: calc(-1 * var(--rule));
  }

  .name {
    font: var(--fw-heavy) var(--fs-d-sm) / 1.1 var(--ff-display);
    letter-spacing: var(--ls-d-sm);
  }

  /* Discord presence: a status dot and its words. */
  .presence {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin-top: 3px;
    font-size: var(--fs-sm);
    color: var(--soft);
  }

  .presence[hidden] {
    display: none;
  }

  /* With JS the line is kept (unseen) until the status arrives. */
  :global(.js) .presence[hidden] {
    display: flex;
    visibility: hidden;
  }

  /* No status (yet): the name moves down by half the kept line (its
     height plus its 3px margin), so it reads centred on the avatar. */
  :global(.js) .who:has(.presence[hidden]) .name {
    transform: translateY(calc((var(--fs-sm) * var(--lh-body) + 3px) / 2));
  }

  .phrase {
    display: inline-grid;
  }

  .phrase > * {
    grid-area: 1 / 1;
  }

  .ghost {
    visibility: hidden;
  }

  .dot {
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    margin-top: calc((1lh - 8px) / 2);
    border-radius: 50%;
    background: var(--st-offline);
  }

  [data-status="online"] .dot {
    background: var(--st-online);
  }

  [data-status="idle"] .dot {
    background: var(--st-idle);
  }

  [data-status="dnd"] .dot {
    background: var(--st-dnd);
  }

  .dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: inherit;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ping .dot::after {
      animation: ping 900ms var(--ease-out) 1;
    }
  }

  /* Played once: never again after the motion setting has changed during
     the visit (html.motion-settled, motion.css). */
  :global(html.motion-settled) .ping .dot::after {
    animation: none;
  }

  @keyframes ping {
    from {
      opacity: 0.6;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  /* Directory rows: the whole row is the link. The divider above each
     group is drawn on the content inset, not across the rows' hover
     padding, as a border so it snaps to the same weight as the page's
     hairlines. */
  .rows {
    position: relative;
    display: grid;
    gap: 2px;
    margin: 0;
    padding: var(--sp-2) 0 0;
    list-style: none;
  }

  .rows + .rows {
    margin-top: var(--sp-2);
  }

  .rows::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--inset);
    right: var(--inset);
    height: 0;
    border-top: var(--rule) solid var(--card-rule);
  }

  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sp-3);
    min-height: 2.75rem;
    padding: var(--sp-2) var(--inset);
    border-radius: 12px;
    background: none;
    color: var(--ink);
    font-weight: var(--fw-medium);
    transition:
      background-color var(--dur-ui) var(--ease-out),
      transform 120ms var(--ease-ui);
  }

  .row svg {
    overflow: visible;
    fill: currentColor;
    color: var(--soft);
    transition: color var(--dur-ui) var(--ease-out);
  }

  .label {
    min-width: 0;
  }

  .act {
    font-size: var(--fs-sm);
    color: var(--soft);
    transition:
      color var(--dur-ui) var(--ease-out),
      transform var(--dur-ui) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .row:hover {
      background: color-mix(in oklab, var(--line) 70%, transparent);
    }

    .row:hover svg,
    .row:hover .act {
      color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .row:active {
      transform: scale(0.97);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .row:hover .act {
      transform: translateX(4px);
    }
  }

  .row:focus-visible {
    outline-offset: 0;
  }

  /* Side by side, the card keeps its own height and sits centred on the
     left column, measured from the statement's cap height (it's trimmed
     to it) to the pill's bottom. */
  @media (min-width: 53.8125rem) {
    .contact {
      align-items: center;
    }

    .statement {
      text-box: trim-start cap alphabetic;
    }
  }

  @media (max-width: 53.75rem) {
    .contact {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 32.5rem) {
    .contact {
      padding-bottom: 0;
    }

    /* A little less padding on the card. */
    .card {
      --inset: var(--sp-2);
      padding: var(--sp-4);
    }
  }
</style>

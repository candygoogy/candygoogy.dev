---
import type { CollectionEntry } from "astro:content";
import fettleIcon from "../assets/logos/fettle-app-icon-small.svg";
import { hero } from "../data/site";
import ProjectIndex from "./ProjectIndex.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
// The index beside the headline is a shortlist, so it stays about as tall
// as the headline and its line however many projects there are: the
// featured ones, in the page's order. The projects list below has them all.
const featured = projects.filter((p) => p.data.featured);
if (featured.length < 1 || featured.length > 4)
  throw new Error("one to four projects must be featured");
// The headline is split into words so each word can rise out of its own
// clip, in turn (motion.css). Screen readers get the sentence once, from
// aria-label.
const words = hero.headline.split(" ");
// The line's mention of Fettle becomes a chip: its app icon and its name,
// linking to its page.
const [lineBefore, lineAfter] = hero.line.split("Fettle");
if (lineAfter === undefined) throw new Error("hero.line must mention Fettle");
// The word before the chip goes with it, so the chip never starts a line
// on its own.
const [, before = "", beforeChip = ""] =
  lineBefore?.match(/^(.*?)(\S+\s*)$/s) ?? [];
// A word of one or two letters stays with the word after it ("On my"),
// so a line never ends on one. Only the spaces change.
const lead = before.replace(/(?<=^|\s)(\S{1,2})\s+(?=\S)/g, "$1\u00a0");
// The last two words stay together, so the last line is never one short
// word on its own (text-wrap alone doesn't manage it in Safari, around the
// chip).
const [, rest = lineAfter, lastPair = ""] =
  lineAfter.match(/^(.*?)(\S+\s+\S+\s*)$/s) ?? [];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="statement">
    <h1 id="hero-title" class="hero-title" aria-label={hero.headline}>
      {words.map((word, i) => (
        <>
          <span class="w" aria-hidden="true" style={`--w: ${i}`}>
            <span>{word}</span>
          </span>
          {i < words.length - 1 && " "}
        </>
      ))}
    </h1>
    <p class="rv" style="--d: 420ms">
      {lead}
      <span class="nobr">
        {beforeChip}
        <a class="mention" href="/fettle" data-preview="pv-fettle">
          <img
            src={fettleIcon.src}
            alt=""
            width="20"
            height="20"
            decoding="async"
          />
          Fettle
        </a>
      </span>
      {rest}
      <span class="nobr">{lastPair}</span>
    </p>
  </div>
  <ProjectIndex projects={featured} headingId="index-title" />
</section>

<style>
  /* The Fettle chip has a 44px tall touch target, laid over the text
     around it without changing the line. */
  .mention {
    position: relative;
  }

  .mention::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 44px;
    translate: 0 -50%;
  }

  /* The index never gets narrower than its longest line (about 20rem),
     so each project's line stays on one line down to where the columns
     stack. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(21rem, 4fr);
    gap: var(--gap-hero);
    align-items: start;
    padding-block: var(--space-hero-top) var(--space-hero-bottom);
  }

  /* Beside the index, the headline's capitals start level with the
     index's top rule: the line box sits 0.113em above the cap height
     (the display face's ascent, descent and cap height at this line
     height). */
  h1 {
    margin-top: -0.113em;
    font-size: var(--fs-d-hero);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-hero);
  }

  /* Each word clips its own rise, with room for descenders. */
  .w {
    display: inline-block;
    clip-path: inset(-0.06em -0.08em -0.14em -0.08em);
  }

  .w > span {
    display: inline-block;
  }

  .statement p {
    margin-top: var(--sp-6);
    max-width: var(--measure-lede);
    font-size: var(--fs-lede);
    color: var(--soft);
    text-wrap: pretty;
  }

  @media (max-width: 53.75rem) {
    .hero {
      grid-template-columns: 1fr;
    }

    h1 {
      margin-top: 0;
    }
  }

  /* In one column the index would be a full-width list, and the band and
     the projects list right after it repeat its rows, so on screen
     it goes (the same breakpoint as above). Print keeps it as the
     receipt's index (print.css). */
  @media screen and (max-width: 53.75rem) {
    .hero > :global(.index) {
      display: none;
    }
  }
</style>

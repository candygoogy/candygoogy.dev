---
import { GITHUB } from "../data/icons";
import Keep from "./Keep.astro";
import { vtAttr } from "../lib/vt";

// A list of things made, one row each: the name with its kind and year on
// the left; the description on the right, under it the row's link (the
// whole row is the link), then one quiet line: the credit in ink, the
// stack soft. A row can also link its source on its own.
export interface Row {
  id: string;
  name: string;
  // Left out where every row would say the same: then only the year shows.
  kind?: string;
  year: number;
  summary: string;
  // The row's link: a page on this site (its address and →), a live site
  // (its domain and ↗) or its source.
  link?:
    | { kind: "page"; href: string; label: string }
    | { kind: "live"; href: string; label: string }
    | { kind: "source"; href: string };
  // The source, as a second link, when the row's link is a live site.
  source?: string;
  // A project with its own page: the title carries its view-transition
  // names (src/lib/vt.ts).
  vt?: string;
  credit: string;
  stack: string[];
}

interface Props {
  id: string;
  // The list's heading. Without one, the section takes its name from
  // labelledBy (a heading already on the page).
  title?: string;
  labelledBy?: string;
  rows: Row[];
  // Ids that old links still use, landing on the list.
  aliases?: string[];
  // The rows' heading level: 3 under the list's heading, 2 when the list
  // is the page's whole content.
  level?: 2 | 3;
  // A closing row for what the list leaves out: how many, one line on
  // what they are, and a page link to where they all are. Not a list
  // item, as it isn't one of the things made.
  more?: { count: number; line: string; href: string; label: string };
}

const {
  id,
  title,
  labelledBy,
  rows,
  aliases = [],
  level = 3,
  more,
} = Astro.props;

const closing = more && more.count > 0 ? more : undefined;
---

<!--
  The section opens like Contact: the section gap, then the heading.
  Each row then uses the section grid: the name with its kind and
  year on the left; the description on the right, under it the row's one
  link, then one quiet line: what I did (ink), the stack (soft).
-->
<section
  id={id}
  class="projects"
  aria-labelledby={title ? `${id}-title` : labelledBy}
>
  {aliases.length > 0 && (
    <Fragment set:html="<!-- Old links to the two lists this one replaced still land here. -->" />
  )}
  {aliases.map((alias) => (
    <span id={alias} class="alias" />
  ))}
  {title && (
    <h2 id={`${id}-title`}>
      <span class="rv-mask">
        <span>{title}</span>
      </span>
    </h2>
  )}
  <ol class="rows">
    {rows.map((row, i) => {
      const go = row.link;
      // With a closing row the last project isn't the list's end.
      const last = i === rows.length - 1 && !closing;
      // A page link's name goes on past its address. Kept in one
      // expression with the label, so no space lands before the comma.
      const about = `, about ${row.name}`;
      return (
        <li
          id={row.id}
          class:list={["row", "rv", { "rv-line at-bottom": !last, end: last }]}
          data-arrive
          data-i={i}
          data-line={last ? undefined : "line"}
        >
          <div class="who">
            {level === 2 ? (
              <h2 class="name">{row.name}</h2>
            ) : (
              <h3
                {...(row.vt ? vtAttr(row.vt) : {})}
                class:list={["name", { "vt-project-title": row.vt }]}
              >
                {row.name}
              </h3>
            )}
            <p class="kind">
              {row.kind && <span>{row.kind}</span>}
              <span>{row.year}</span>
            </p>
          </div>
          <div class="what">
            <p class="desc">
              <Keep text={row.summary} />
            </p>
            <div class="meta">
              {go &&
                (go.kind === "page" ? (
                  <a class="go" href={go.href}>
                    {[go.label, <span class="visually-hidden">{about}</span>]}
                    <svg
                      class="arr next"
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      aria-hidden="true"
                    >
                      <path d="M3.5 8h9M8.5 4l4 4-4 4" />
                    </svg>
                  </a>
                ) : go.kind === "live" ? (
                  <a class="go" href={go.href}>
                    {go.label}
                    <svg
                      class="arr"
                      viewBox="0 0 16 16"
                      width="14"
                      height="14"
                      aria-hidden="true"
                    >
                      <path d="M5 11 11 5M6 5h5v5" />
                    </svg>
                  </a>
                ) : (
                  <a class="go" href={go.href}>
                    <svg
                      class="mark"
                      viewBox="0 0 24 24"
                      width="16"
                      height="16"
                      aria-hidden="true"
                    >
                      <path d={GITHUB} />
                    </svg>
                    Source
                    <span class="visually-hidden">
                      {" "}
                      of {row.name} on GitHub
                    </span>
                  </a>
                ))}
              {row.source && (
                <a class="src" href={row.source}>
                  <svg
                    class="mark"
                    viewBox="0 0 24 24"
                    width="16"
                    height="16"
                    aria-hidden="true"
                  >
                    <path d={GITHUB} />
                  </svg>
                  Source
                  <span class="visually-hidden"> of {row.name} on GitHub</span>
                </a>
              )}
              <p class="credit">
                {row.credit && <span class="role">{row.credit}</span>}
                <span class="stack">
                  {row.stack.flatMap((tool, i) => [
                    // The dot is only seen; the space after it keeps the
                    // names apart when read aloud.
                    i > 0 && [<span aria-hidden="true">{" ·"}</span>, " "],
                    tool,
                  ])}
                </span>
              </p>
            </div>
          </div>
        </li>
      );
    })}
  </ol>
  {closing && (
    <div class="row rv end" data-i={rows.length}>
      <div class="who">
        <p class="kind">
          <span>{closing.count} more</span>
        </p>
      </div>
      <div class="what">
        <p class="desc">
          <Keep text={closing.line} />
        </p>
        <div class="meta">
          <a class="go" href={closing.href}>
            {[
              closing.label,
              <span class="visually-hidden">, every project</span>,
            ]}
            <svg
              class="arr next"
              viewBox="0 0 16 16"
              width="14"
              height="14"
              aria-hidden="true"
            >
              <path d="M3.5 8h9M8.5 4l4 4-4 4" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  )}
</section>

<style>
  .projects {
    margin-top: var(--space-section);
  }

  .alias {
    position: absolute;
    top: 0;
  }

  h2 {
    margin-bottom: var(--sp-7);
    font-size: var(--fs-d-section);
    line-height: 1;
    letter-spacing: var(--ls-section);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    column-gap: var(--gap-hero);
    row-gap: var(--sp-4);
    padding-block: var(--sp-7);
    scroll-margin-top: var(--sp-5);
    isolation: isolate;
  }

  /* The list ends on its last line of text: no rule under it, so the gap
     to About is the usual section gap. */
  .row.end {
    padding-bottom: 0;
  }

  /* Identity: the name reads as a title; the kind and year sit under it. */
  .name {
    font-size: clamp(1.75rem, 1rem + 1.6vw, 2.5rem);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-section);
  }

  .kind {
    display: flex;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
    font-size: var(--fs-meta);
    color: var(--soft);
    font-variant-numeric: tabular-nums;
  }

  /* The closing row's count stands alone, with no name above it. */
  .who > .kind:first-child {
    margin-top: 0;
  }

  /* The description in ink at lede size. The meta row spans the column
     the description fills, so the column has one right edge: a 60ch of its
     own, at the smaller size, stopped short and broke the credit line. */
  .desc {
    max-width: 60ch;
  }

  .desc {
    font-size: var(--fs-lede);
    color: var(--ink);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-5);
    margin-top: var(--sp-5);
    font-size: var(--fs-meta);
    color: var(--soft);
  }

  /* The credit and the stack take their own line under the link(s): left
     to wrap, they sat beside them in rows with a short stack and fell
     under them in the rest. A wider gap parts the two, and dots part the
     tools (the credit has the commas). Too long for one line, the stack
     moves under the credit whole. */
  .meta > p {
    flex-basis: 100%;
  }

  .credit {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
  }

  .role {
    color: var(--ink);
  }

  /* The row's one link. An exception to the link colour: ink at medium
     weight, not the accent, and no marker (the row's tint is its hover);
     it turns the accent with the row. */
  .go {
    display: inline-flex;
    align-items: center;
    align-self: center;
    gap: var(--sp-2);
    margin-inline: 0;
    padding-inline: 0;
    border-radius: var(--r-focus);
    background: none;
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-ui) var(--ease-ui);
    /* The press is the row's own tint (below), not the browser's grey box
       over the stretched link. */
    -webkit-tap-highlight-color: transparent;
  }

  .go svg {
    flex: none;
    transition: transform var(--dur-ui) var(--ease-ui);
  }

  .mark {
    fill: currentColor;
  }

  .arr {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The whole row is the link: its box stretches over the row. */
  .go::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  /* The row's tint, like the contact card's rows: on hover, on keyboard
     focus, and briefly on arrival from a link on the page (.arrived, set
     by scripts/loader.ts; not on a load or reload), so the eye finds the
     row it jumped to. It is its own layer reaching a little past the
     text, so the text keeps the page's left edge and the rule stays on
     the content edges. */
  .row::after {
    content: "";
    position: absolute;
    inset: var(--sp-2) calc(-1 * var(--sp-4));
    z-index: -1;
    border-radius: 14px;
    background: color-mix(in oklab, var(--line) 45%, transparent);
    opacity: 0;
    transition: opacity var(--dur-ui) var(--ease-out);
  }

  .row.end::after {
    bottom: calc(-1 * var(--sp-5));
  }

  .row:has(.go:focus-visible)::after {
    opacity: 1;
  }

  /* A press (touch has no hover) shows the tint, so the tap is felt before
     the page changes; on release it fades at the hover's pace. It waits
     80ms first: iOS applies :active as soon as a finger lands, and a
     scroll that starts on a row has taken over by then, so the rows don't
     flash under a swipe. Source on /experiments sits outside the row link,
     so pressing it leaves the row as it is. */
  .row:has(.go:active)::after {
    opacity: 1;
    transition-duration: var(--dur-fast);
    transition-delay: 80ms;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The arrow lifts on a press as on hover. */
    .row:has(.go:active) .arr {
      transform: translate(2px, -2px);
      transition-delay: 80ms;
    }

    .row:global(.arrived)::after {
      animation: row-arrive 2.4s var(--ease-out) 350ms;
    }
  }

  @keyframes row-arrive {
    15%,
    55% {
      opacity: 1;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .row:hover::after {
      opacity: 1;
    }

    .row:hover .go {
      color: var(--acc);
    }

    .row:hover .arr {
      transform: translate(2px, -2px);
    }

    .row:hover .next {
      transform: translateX(2px);
    }

    .row:hover .mark {
      transform: rotate(-8deg);
    }
  }

  /* Phones: one column; the link on its own line, the sentence under it. */
  @media (max-width: 53.75rem) {
    .row {
      grid-template-columns: 1fr;
      padding-block: var(--sp-6);
    }

    /* Under the list's heading, half the full gap (8px plus the first
       row's own 32px, not 48 plus 32), so the heading reads with its list
       rather than with the line above it, without running into the first
       name. */
    h2 {
      margin-bottom: var(--sp-2);
    }

    .meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-2);
      margin-top: var(--sp-4);
    }

    .go {
      align-self: flex-start;
    }
  }
</style>

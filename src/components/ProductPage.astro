---
// A product's page (/fettle, /idiff, ...): the band as the header (the
// product only), why I made it, what it checks (or does), what you can do
// with it, privacy, what I learned, and the way to get it. From the band's
// head down to Privacy the parts share the band's 5/6 columns. Everything
// comes from the project's entry, the two section headings too.
import type { CollectionEntry } from "astro:content";
import FettleBand from "./FettleBand.astro";
import Keep from "./Keep.astro";
import ProjectNames from "./ProjectNames.astro";
import Shot from "./Shot.astro";
import Base from "../layouts/Base.astro";
import { featuredProject, site } from "../data/site";
import { nextProduct, orderedProjects, release } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
  // Slot "example": a real example of what it makes, at the end of what
  // you can do with it.
}

const { project } = Astro.props;
const { data } = project;
const page = data.page;
if (!page) throw new Error(`projects/${project.id}.md needs its page sections`);
const story = data.story;
if (!story) throw new Error(`projects/${project.id}.md needs its story`);
const { version, get } = release(project);
// A product without a site of its own is described by this page, with the
// release as its download and the repository as the same thing elsewhere.
const own = !data.links.live;
// Where the page goes next: the next product in the site's order.
const next = nextProduct(await orderedProjects(), project.id);

// Structured data: the product as a free application, on the systems and
// of the kind its entry gives (Windows utility unless it says otherwise).
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: data.name,
  description: data.summary,
  url: data.links.live ?? `${site.url}/${project.id}`,
  applicationCategory: data.category,
  operatingSystem: data.os,
  softwareVersion: version,
  license:
    data.license &&
    `https://opensource.org/license/${data.license.toLowerCase()}`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: site.name, url: site.url },
  downloadUrl: own ? get : undefined,
  sameAs: own ? data.links.source : undefined,
};

// The uses as one list; the screenshots of those that have one sit beside
// it, in the uses' order.
const shots = page.uses
  .map((u) => (u.shot === undefined ? undefined : data.images[u.shot]))
  .filter((shot) => shot !== undefined);
// A use's linked phrase, split out of its text. The phrase must be in the
// text as written (the schema checks it too).
const parts = (text: string, phrase: string) => {
  const at = text.indexOf(phrase);
  if (at < 0) throw new Error(`"${phrase}" isn't in the use "${text}"`);
  return [text.slice(0, at), text.slice(at + phrase.length)];
};

// The checks run three across (two on tablets, one on phones). When the
// last row has room left, the note sits in it, beside the last check,
// rather than under a row with gaps in it.
const checks = page.checks.length;
const beside = [
  checks % 3 === 1 && "beside-3",
  checks % 2 === 1 && "beside-2",
].filter(Boolean);
// The grid's row count comes from data attributes mapped in the styles
// below, not a style="" (it would cost the page a hash in its CSP, see
// motion.css). They're mapped for up to 12 checks.
const note = page.checksNote && beside.length > 0;
if (note && checks > 12) {
  throw new Error(
    `projects/${project.id}.md has ${checks} checks; the note beside the last one is mapped for up to 12. Map more rows ([data-rows-3], [data-rows-2]) in ProductPage.astro.`,
  );
}
// Privacy, then What I learned when there is one: each its first
// paragraph set large, the rest beside it.
const pairs = [
  { id: "privacy-title", title: "Privacy", text: page.privacy },
  ...(page.learned
    ? [{ id: "learned-title", title: "What I learned", text: page.learned }]
    : []),
].map((part) => {
  const [lead = "", ...rest] = part.text.split("\n\n");
  return { ...part, lead, rest };
});
const rows = note
  ? {
      "data-rows-3": Math.ceil(checks / 3),
      "data-rows-2": Math.ceil(checks / 2),
    }
  : {};
---

<Base
  section="Projects"
  title={`${data.name} – candygoogy`}
  description={data.summary}
  ogImage={`/og-${project.id}.png`}
  ogAlt={`${data.name}: ${data.summary.split(". ")[0]}.`}
  schema={schema}
>
  {project.id !== featuredProject && (
    <ProjectNames slot="head" projects={[project]} />
  )}
  <div class="top">
    <FettleBand project={project} page />
  </div>

  <!-- Why I made it, at the lede's size, with what was hard and what it
       won't do beside it. -->
  <section class="sec" aria-labelledby="why-title">
    <h2 id="why-title">
      <span class="rv-mask">
        <span>Why</span>
      </span>
    </h2>
    <div class="pair">
      <p class="lead rv">{story.why}</p>
      <div class="side">
        <h3 class="rv" data-i="0">
          What was hard
        </h3>
        <p class="rv" data-i="1">
          {story.hard}
        </p>
        <h3 class="rv" data-i="2">
          What it won’t do
        </h3>
        <p class="rv" data-i="3">
          {story.promise}
        </p>
      </div>
    </div>
  </section>

  <!-- What it checks: the items on a grid, each under a drawn hairline,
       and the note after them. -->
  <section class="sec" aria-labelledby="checks-title">
    <h2 id="checks-title">
      <span class="rv-mask">
        <span>{page.checksTitle}</span>
      </span>
    </h2>
    <div class:list={["checks-grid", page.checksNote && beside]} {...rows}>
      <ul class="checks">
        {page.checks.map((c, i) => (
          <li class="rv rv-line" data-i={i} data-line="line">
            <h3>{c.name}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
      {page.checksNote && <p class="note rv">{page.checksNote}</p>}
    </div>
  </section>

  <!-- What you can do: every use in one list, a hairline between them, and
       the screenshots beside it, in the uses' order. A real example (a
       receipt) follows on the same columns. -->
  <section class="sec" aria-labelledby="uses-title">
    <h2 id="uses-title">
      <span class="rv-mask">
        <span>{page.usesTitle}</span>
      </span>
    </h2>
    <div class="pair">
      <ul class="uses">
        {page.uses.map((u, i) => (
          <li
            class:list={["rv", { "rv-line": i > 0 }]}
            data-i={i}
            data-line={i > 0 ? "line" : undefined}
          >
            {u.link ? (
              <>
                {parts(u.text, u.link.text)[0]}
                <a href={u.link.href}>{u.link.text}</a>
                {parts(u.text, u.link.text)[1]}
              </>
            ) : (
              u.text
            )}
          </li>
        ))}
      </ul>
      {shots.length > 0 && (
        <div class="figs">
          {shots.map((shot) => (
            <figure class="rv" data-d="120" data-tilt>
              <div class="tilt">
                <Shot
                  src={shot.light}
                  phone={shot.phone?.light}
                  alt={shot.alt}
                  sizes="(min-width: 84rem) 700px, (min-width: 53.75rem) 52vw, 90vw"
                />
              </div>
              <figcaption>{shot.caption}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
    <slot name="example" />
  </section>

  <!-- Privacy, then What I learned when there is one: the first paragraph
       at the lede's size, the rest beside it. -->
  {pairs.map((part) => (
    <section class="sec" aria-labelledby={part.id}>
      <h2 id={part.id}>
        <span class="rv-mask">
          <span>{part.title}</span>
        </span>
      </h2>
      <div class="pair">
        <p class="lead rv">
          <Keep text={part.lead} />
        </p>
        {part.rest.length > 0 && (
          <div class="side">
            {part.rest.map((para, i) => (
              <p class="rv" data-i={i}>
                <Keep text={para} />
              </p>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- The landing: a closing panel on the band's surface, so the page is
       framed at both ends: the ask and the product's line on the left,
       the button on the right (the band's facts carry the source and the
       version, so each is said once). Under it, the way back to every
       project and on to the next product. -->
  <section class="cta" aria-labelledby="cta-title" data-box>
    <div class="panel band rv">
      <div class="ask">
        <h2 id="cta-title">
          <span class="rv-mask">
            <span>Get {data.name}</span>
          </span>
        </h2>
        <p class="pitch rv">
          <Keep text={data.blurb} />
        </p>
      </div>
      {get && (
        <div class="actions rv" data-d="160">
          <a class="get" href={get}>
            {data.links.live ? "Visit the site" : "Download"}
          </a>
        </div>
      )}
    </div>
    <nav class="way rv" data-d="300" aria-label="More projects">
      <a href="/projects">
        <svg
          class="arr back"
          viewBox="0 0 16 16"
          width="14"
          height="14"
          aria-hidden="true"
        >
          <path d="M12.5 8h-9M7.5 4l-4 4 4 4" />
        </svg>
        All projects
      </a>
      {next && (
        <a href={`/${next.id}`}>
          Next: {next.data.name}
          <svg
            class="arr fwd"
            viewBox="0 0 16 16"
            width="14"
            height="14"
            aria-hidden="true"
          >
            <path d="M3.5 8h9M8.5 4l4 4-4 4" />
          </svg>
        </a>
      )}
    </nav>
  </section>
</Base>

<style>
  .top {
    padding-top: var(--sp-5);
  }

  .sec {
    padding-top: var(--space-section);
  }

  .sec > h2 {
    margin-bottom: var(--sp-7);
    font-size: var(--fs-d-section);
    line-height: 1;
    letter-spacing: var(--ls-section);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The checks, three across on desktop. */
  .checks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-6) var(--sp-7);
  }

  .checks li {
    padding-top: var(--sp-4);
  }

  .checks h3 {
    margin-bottom: var(--sp-2);
    font-size: var(--fs-d-sm);
    letter-spacing: var(--ls-d-sm);
  }

  .note {
    max-width: var(--measure);
    margin-top: var(--sp-6);
  }

  /* The note beside the last check: the list's rows become the outer
     grid's (subgrid), and the note takes the free cells of the last one,
     its text level with the checks' names. Without subgrid it stays
     under the list. The row counts come from data-rows-3 and data-rows-2,
     mapped here for up to 12 checks (the build throws past that). */
  [data-rows-3="1"] {
    --rows-3: 1;
  }
  [data-rows-3="2"] {
    --rows-3: 2;
  }
  [data-rows-3="3"] {
    --rows-3: 3;
  }
  [data-rows-3="4"] {
    --rows-3: 4;
  }
  [data-rows-2="1"] {
    --rows-2: 1;
  }
  [data-rows-2="2"] {
    --rows-2: 2;
  }
  [data-rows-2="3"] {
    --rows-2: 3;
  }
  [data-rows-2="4"] {
    --rows-2: 4;
  }
  [data-rows-2="5"] {
    --rows-2: 5;
  }
  [data-rows-2="6"] {
    --rows-2: 6;
  }

  @supports (grid-template-rows: subgrid) {
    @media (width > 53.75rem) {
      .beside-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--sp-6) var(--sp-7);
      }

      .beside-3 > .checks {
        grid-column: 1 / -1;
        grid-row: 1 / span var(--rows-3);
        grid-template-columns: subgrid;
        grid-template-rows: subgrid;
      }

      .beside-3 > .note {
        grid-column: 2 / -1;
        grid-row: var(--rows-3);
        margin-top: 0;
        padding-top: var(--sp-4);
      }
    }

    @media (32.5rem < width <= 53.75rem) {
      .beside-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-6) var(--sp-7);
      }

      .beside-2 > .checks {
        grid-column: 1 / -1;
        grid-row: 1 / span var(--rows-2);
        grid-template-columns: subgrid;
        grid-template-rows: subgrid;
      }

      .beside-2 > .note {
        grid-column: 2;
        grid-row: var(--rows-2);
        margin-top: 0;
        padding-top: var(--sp-4);
      }
    }
  }

  /* The band's 5/6 columns, from its head down to Privacy: Why, the
     uses and their screenshots, Privacy and What I learned each set their
     two parts on them, the large text on the left. */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--sp-6) var(--sp-8);
    align-items: start;
  }

  /* The first part, at the lede's size: Why, a privacy section's first
     paragraph. */
  .lead {
    max-width: var(--measure-lede);
    font-size: var(--fs-lede);
    color: var(--ink);
  }

  /* Beside it, at body size: What was hard and What it won't do, the
     other paragraphs. Its first line is level with the lead's. */
  .side {
    padding-top: var(--sp-1);
  }

  .side p {
    max-width: var(--measure);
  }

  .side p + p,
  .side p + h3 {
    margin-top: var(--sp-5);
  }

  .side h3 {
    margin-bottom: var(--sp-2);
    font-size: var(--fs-d-sm);
    letter-spacing: var(--ls-d-sm);
  }

  /* The uses: one list at the lede's size, a hairline between rows (a
     list never ends on one). */
  .uses li {
    max-width: 34ch;
    padding-block: var(--sp-5);
    font-size: var(--fs-lede);
    color: var(--ink);
  }

  .uses li:first-child {
    padding-top: 0;
  }

  .uses li:last-child {
    padding-bottom: 0;
  }

  /* Their screenshots, stacked in the uses' order, each with its
     caption. */
  .figs {
    display: grid;
    gap: var(--sp-7);
  }

  figure {
    margin: 0;
    perspective: 1400px;
  }

  .tilt {
    transition: transform var(--dur-tilt) var(--ease-out);
  }

  figure :global(img) {
    width: 100%;
    border-radius: var(--r-shot);
    border: var(--rule) solid var(--line);
  }

  figcaption {
    margin-top: var(--sp-3);
    font-size: var(--fs-meta);
    color: var(--soft);
  }

  /* The landing: a panel on the band's surface and radius, as wide as
     the band (out to the window's gutters), the ask on the left and the
     actions on the right, their last lines level. The band class gives it
     the band's accent, focus ring and selection (base.css); its look is
     set here, not shared with FettleBand. */
  .cta {
    margin-top: var(--space-section);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--sp-6) var(--sp-8);
    align-items: end;
    margin-inline: calc(-1 * var(--gutter));
    padding: var(--sp-8) var(--gutter);
    border-radius: var(--r-band);
    background: var(--band);
    color: var(--band-ink);
  }

  .ask h2 {
    font-size: var(--fs-d-section);
    line-height: 1;
    letter-spacing: var(--ls-section);
  }

  .pitch {
    max-width: var(--measure-lede);
    margin-top: var(--sp-4);
    font-size: var(--fs-lede);
    color: var(--band-soft);
    text-wrap: pretty;
  }

  /* The one solid button on the site: the band's ink as its fill and the
     band's color as its text, the accent on hover. */
  .get {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 var(--sp-6);
    border-radius: var(--r-pill);
    background: var(--band-ink);
    color: var(--band);
    font: var(--fw-d-bold) var(--fs-body) / var(--lh-body) var(--ff-display);
    letter-spacing: var(--ls-d-sm);
    transition:
      background-color var(--dur-ui) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .get:hover {
      background: var(--acc);
      color: var(--band);
    }
  }

  .get:active {
    transform: scale(0.97);
  }

  .get:focus-visible {
    outline-offset: 3px;
  }

  /* Under the panel, on the page's edges: back to every project on the
     left, on to the next product on the right. Ink at medium weight with
     a drawn arrow, as the project rows' links, turning the accent on
     hover, the arrow a step further along; each 44px tall. */
  .way {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-6);
    margin-top: var(--sp-5);
  }

  .way a {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding-bottom: 0;
    border-radius: var(--r-focus);
    background: none;
    font-weight: var(--fw-medium);
    color: var(--ink);
    text-decoration: none;
    transition: color var(--dur-ui) var(--ease-ui);
  }

  .arr {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur-ui) var(--ease-ui);
  }

  @media (hover: hover) and (pointer: fine) {
    .way a:hover {
      color: var(--acc);
    }

    .way a:hover .back {
      transform: translateX(-2px);
    }

    .way a:hover .fwd {
      transform: translateX(2px);
    }
  }

  @media (width <= 53.75rem) {
    .checks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pair {
      grid-template-columns: 1fr;
    }

    .side {
      padding-top: 0;
    }

    /* The panel stacks: the ask, then the actions under it, on its left
       edge; its corners as the band's at this size. */
    .panel {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
      align-items: start;
      padding-block: var(--sp-7);
      border-radius: var(--r-band-narrow);
    }
  }

  @media (width <= 32.5rem) {
    .checks {
      grid-template-columns: 1fr;
    }
  }

  /* Forced colors drop the fills: an edge in the text color keeps the
     button a button and the panel a panel. */
  @media (forced-colors: active) {
    .get {
      border: var(--rule) solid currentColor;
    }

    .panel {
      outline: var(--rule) solid CanvasText;
      outline-offset: calc(-1 * var(--rule));
    }
  }
</style>

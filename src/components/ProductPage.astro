---
// A product's page (/fettle, /idiff): the band as the header, what it
// checks, what you can do with it, privacy, what I learned, and the way to
// get it. Everything comes from the project's entry.
import type { CollectionEntry } from "astro:content";
import FettleBand from "./FettleBand.astro";
import Keep from "./Keep.astro";
import ProjectNames from "./ProjectNames.astro";
import Shot from "./Shot.astro";
import Base from "../layouts/Base.astro";
import { featuredProject, site } from "../data/site";
import { release } from "../lib/projects";

interface Props {
  project: CollectionEntry<"projects">;
  // Slot "example": a real example of what it makes, at the end of what
  // you can do with it.
}

const { project } = Astro.props;
const { data } = project;
const page = data.page;
if (!page) throw new Error(`projects/${project.id}.md needs its page sections`);
const { version, get } = release(project);
// A product without a site of its own is described by this page, with the
// release as its download and the repository as the same thing elsewhere.
const own = !data.links.live;

// Structured data: the product as a free Windows application.
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: data.name,
  description: data.summary,
  url: data.links.live ?? `${site.url}/${project.id}`,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Windows 10, Windows 11",
  softwareVersion: version,
  license:
    data.license &&
    `https://opensource.org/license/${data.license.toLowerCase()}`,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: site.name, url: site.url },
  downloadUrl: own ? get : undefined,
  sameAs: own ? data.links.source : undefined,
};

// Uses with a screenshot get it beside them; the rest sit together after.
const shown = page.uses.filter((u) => u.shot !== undefined);
const plain = page.uses.filter((u) => u.shot === undefined);
// A use's linked phrase, split out of its text. The phrase must be in the
// text as written (the schema checks it too).
const parts = (text: string, phrase: string) => {
  const at = text.indexOf(phrase);
  if (at < 0) throw new Error(`"${phrase}" isn't in the use "${text}"`);
  return [text.slice(0, at), text.slice(at + phrase.length)];
};

// The checks run three across (two on tablets, one on phones). When the
// last row has room left, the note sits in it, beside the last check,
// rather than under a row with gaps in it.
const checks = page.checks.length;
const beside = [
  checks % 3 === 1 && "beside-3",
  checks % 2 === 1 && "beside-2",
].filter(Boolean);
// The grid's row count comes from data attributes mapped in the styles
// below, not a style="" (it would cost the page a hash in its CSP, see
// motion.css). They're mapped for up to 12 checks.
const note = page.checksNote && beside.length > 0;
if (note && checks > 12) {
  throw new Error(
    `projects/${project.id}.md has ${checks} checks; the note beside the last one is mapped for up to 12. Map more rows ([data-rows-3], [data-rows-2]) in ProductPage.astro.`,
  );
}
const rows = note
  ? {
      "data-rows-3": Math.ceil(checks / 3),
      "data-rows-2": Math.ceil(checks / 2),
    }
  : {};
---

<Base
  section="Projects"
  title={`${data.name} – candygoogy`}
  description={data.summary}
  ogImage={`/og-${project.id}.png`}
  ogAlt={`${data.name}: ${data.summary.split(". ")[0]}.`}
  schema={schema}
>
  {project.id !== featuredProject && (
    <ProjectNames slot="head" projects={[project]} />
  )}
  <div class="top">
    <FettleBand project={project} page />
  </div>

  <!-- What it checks: the items on a grid, each under a drawn hairline,
       and the note after them. -->
  <section class="sec" aria-labelledby="checks-title">
    <h2 id="checks-title">
      <span class="rv-mask">
        <span>What it checks</span>
      </span>
    </h2>
    <div class:list={["checks-grid", page.checksNote && beside]} {...rows}>
      <ul class="checks">
        {page.checks.map((c, i) => (
          <li class="rv rv-line" data-i={i} data-line="line">
            <h3>{c.name}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ul>
      {page.checksNote && <p class="note rv">{page.checksNote}</p>}
    </div>
  </section>

  <!-- What you can do: each screenshot sits beside the line it shows. -->
  <section class="sec" aria-labelledby="uses-title">
    <h2 id="uses-title">
      <span class="rv-mask">
        <span>What you can do with the receipt</span>
      </span>
    </h2>
    <ul class="uses">
      {shown.map((u) => {
        const shot = data.images[u.shot ?? 0];
        return (
          <li class="use rv-line" data-line="line">
            <p class="rv">{u.text}</p>
            {shot && (
              <figure class="rv" data-d="120" data-tilt>
                <div class="tilt">
                  <Shot
                    src={shot.light}
                    phone={shot.phone?.light}
                    alt={shot.alt}
                    sizes="(min-width: 53.75rem) 700px, 90vw"
                  />
                </div>
                <figcaption>{shot.caption}</figcaption>
              </figure>
            )}
          </li>
        );
      })}
    </ul>
    <ul class="more">
      {plain.map((u, i) => (
        <li class="rv rv-line" data-i={i} data-line="line">
          {u.link ? (
            <>
              {parts(u.text, u.link.text)[0]}
              <a href={u.link.href}>{u.link.text}</a>
              {parts(u.text, u.link.text)[1]}
            </>
          ) : (
            u.text
          )}
        </li>
      ))}
    </ul>
    <slot name="example" />
  </section>

  <!-- Privacy and what I learned: short, so they sit as a pair. Privacy
       alone sits on the page's 4/7 columns, its heading on the left. -->
  <section
    class:list={["pair", { single: !page.learned }]}
    aria-label={page.learned ? "Privacy and what I learned" : "Privacy"}
  >
    <div class="rv">
      <h2>Privacy</h2>
      {page.privacy.split("\n\n").map((para) => (
        <p>
          <Keep text={para} />
        </p>
      ))}
    </div>
    {page.learned && (
      <div class="rv" data-i="1">
        <h2>What I learned</h2>
        {page.learned.split("\n\n").map((para) => (
          <p>{para}</p>
        ))}
      </div>
    )}
  </section>

  <!-- The landing: the promise, the download, and a way back. -->
  <section class="cta" aria-labelledby="cta-title">
    <h2 id="cta-title" class="visually-hidden">
      Get {data.name}
    </h2>
    <p class="statement rv">
      <Keep text={`${data.summary.split(". ")[0]}.`} />
    </p>
    <div class="actions rv" data-d="160">
      {get && (
        <a class="get" href={get}>
          Get {data.name}
        </a>
      )}
      {data.links.source && (
        <a class="source" href={data.links.source}>
          Source on GitHub
        </a>
      )}
    </div>
    <ul class="facts rv" data-d="240">
      {version && <li>Version {version}</li>}
      {data.runsOn && (
        <li>
          <Keep text={data.runsOn} />
        </li>
      )}
      {data.license && <li>Free and open source, {data.license}</li>}
    </ul>
    <p class="back rv" data-d="300">
      <a class="tap" href="/projects">
        Back to all projects
      </a>
    </p>
  </section>
</Base>

<style>
  .top {
    padding-top: var(--sp-5);
  }

  .sec {
    padding-top: var(--space-section);
  }

  .sec > h2,
  .pair h2 {
    margin-bottom: var(--sp-7);
    font-size: var(--fs-d-section);
    line-height: 1;
    letter-spacing: var(--ls-section);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The checks, three across on desktop. */
  .checks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-6) var(--sp-7);
  }

  .checks li {
    padding-top: var(--sp-4);
  }

  .checks h3 {
    margin-bottom: var(--sp-2);
    font-size: var(--fs-d-sm);
    letter-spacing: var(--ls-d-sm);
  }

  .note {
    max-width: var(--measure);
    margin-top: var(--sp-6);
  }

  /* The note beside the last check: the list's rows become the outer
     grid's (subgrid), and the note takes the free cells of the last one,
     its text level with the checks' names. Without subgrid it stays
     under the list. The row counts come from data-rows-3 and data-rows-2,
     mapped here for up to 12 checks (the build throws past that). */
  [data-rows-3="1"] {
    --rows-3: 1;
  }
  [data-rows-3="2"] {
    --rows-3: 2;
  }
  [data-rows-3="3"] {
    --rows-3: 3;
  }
  [data-rows-3="4"] {
    --rows-3: 4;
  }
  [data-rows-2="1"] {
    --rows-2: 1;
  }
  [data-rows-2="2"] {
    --rows-2: 2;
  }
  [data-rows-2="3"] {
    --rows-2: 3;
  }
  [data-rows-2="4"] {
    --rows-2: 4;
  }
  [data-rows-2="5"] {
    --rows-2: 5;
  }
  [data-rows-2="6"] {
    --rows-2: 6;
  }

  @supports (grid-template-rows: subgrid) {
    @media (width > 53.75rem) {
      .beside-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--sp-6) var(--sp-7);
      }

      .beside-3 > .checks {
        grid-column: 1 / -1;
        grid-row: 1 / span var(--rows-3);
        grid-template-columns: subgrid;
        grid-template-rows: subgrid;
      }

      .beside-3 > .note {
        grid-column: 2 / -1;
        grid-row: var(--rows-3);
        margin-top: 0;
        padding-top: var(--sp-4);
      }
    }

    @media (32.5rem < width <= 53.75rem) {
      .beside-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-6) var(--sp-7);
      }

      .beside-2 > .checks {
        grid-column: 1 / -1;
        grid-row: 1 / span var(--rows-2);
        grid-template-columns: subgrid;
        grid-template-rows: subgrid;
      }

      .beside-2 > .note {
        grid-column: 2;
        grid-row: var(--rows-2);
        margin-top: 0;
        padding-top: var(--sp-4);
      }
    }
  }

  /* Each use with its screenshot: the line on the left (4), the picture
     on the right (7), on the page's section grid. */
  .use {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--sp-5) var(--gap-hero);
    align-items: start;
    padding-block: var(--sp-6);
  }

  .use > p {
    max-width: 34ch;
    padding-top: var(--sp-2);
    font-size: var(--fs-lede);
    color: var(--ink);
  }

  figure {
    margin: 0;
    perspective: 1400px;
  }

  .tilt {
    transition: transform var(--dur-tilt) var(--ease-out);
  }

  figure :global(img) {
    width: 100%;
    border-radius: var(--r-shot);
    border: var(--rule) solid var(--line);
  }

  figcaption {
    margin-top: var(--sp-3);
    font-size: var(--fs-meta);
    color: var(--soft);
  }

  /* The uses without a screenshot: the same lede size, two equal columns
     at the measure, so they read as the list's end, not a footnote. */
  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--gap-hero);
  }

  .more li {
    max-width: var(--measure);
    padding-block: var(--sp-5);
    font-size: var(--fs-lede);
    color: var(--ink);
  }

  /* Privacy and What I learned, side by side. */
  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-7) var(--gap-hero);
    padding-top: var(--sp-9);
  }

  .single {
    grid-template-columns: 1fr;
  }

  .single > div {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    column-gap: var(--gap-hero);
    align-items: start;
  }

  .single h2 {
    grid-row: 1 / span 9;
  }

  .single p {
    grid-column: 2;
  }

  .pair h2 {
    margin-bottom: var(--sp-4);
    font-size: var(--fs-d-md);
    letter-spacing: var(--ls-d-sm);
  }

  .pair p {
    max-width: var(--measure);
  }

  .pair p + p {
    margin-top: var(--sp-4);
  }

  /* The landing. */
  .cta {
    margin-top: var(--space-section);
  }

  .statement {
    max-width: 24ch;
    font: var(--fw-d-bold) var(--fs-d-section) / 1.08 var(--ff-display);
    letter-spacing: var(--ls-section);
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4) var(--sp-6);
    margin-top: var(--sp-6);
  }

  /* The one solid button on the site: ink fill, page-colored text. */
  .get {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 var(--sp-6);
    border-radius: var(--r-pill);
    background: var(--ink);
    color: var(--bg);
    font: var(--fw-d-bold) var(--fs-body) / 1 var(--ff-display);
    letter-spacing: var(--ls-d-sm);
    transition:
      background-color var(--dur-ui) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .get:hover {
      background: var(--acc);
      color: var(--bg);
    }
  }

  .get:active {
    transform: scale(0.97);
  }

  .get:focus-visible {
    outline-offset: 3px;
  }

  /* A 44px tall touch target, laid over the line without changing it. */
  .source {
    position: relative;
    font-weight: var(--fw-medium);
  }

  .source::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 44px;
    translate: 0 -50%;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
    margin-top: var(--sp-6);
    font-size: var(--fs-meta);
    color: var(--soft);
  }

  .back {
    margin-top: var(--sp-7);
    font-size: var(--fs-meta);
  }

  @media (width <= 53.75rem) {
    .checks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .use,
    .more,
    .pair,
    .single > div {
      grid-template-columns: 1fr;
    }

    .single h2 {
      grid-row: auto;
    }

    .single p {
      grid-column: auto;
    }
  }

  @media (width <= 32.5rem) {
    .checks {
      grid-template-columns: 1fr;
    }

    /* Phones: the facts one per line on the left edge, rather than
       wrapping into a ragged second column. */
    .facts {
      flex-direction: column;
    }
  }

  /* Forced colors drop the button's fill: an edge in its text color
     keeps it a button. */
  @media (forced-colors: active) {
    .get {
      border: var(--rule) solid currentColor;
    }
  }
</style>

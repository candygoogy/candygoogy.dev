---
// The home network as a tree, in the 404 panel's language: a hairline
// frame with corner ticks, line icons, and hairline links, all wired (the
// access point is powered over its cable, PoE). Decorative (aria-hidden):
// the rows below it carry the same information. Products only: never
// hostnames, addresses, ports or versions.
// Drawn at 1:1, never scaled, so the type stays at its real sizes (names
// at body size, roles small and soft), centred in the frame: where it has
// room, a wide layout (Internet above the router, its three links on a
// bus, the server off the switch); with less, the same with the server
// under the switch; otherwise a vertical, indented tree. Each drawing's
// box is trimmed to its ink, so the frame's padding stays even. The links
// draw once as it scrolls in (motion.css: .rv); then a packet runs from
// the Internet down every branch, and once it reaches the access point,
// the access point keeps broadcasting to its right (see the script).
// Hovering a node sends a packet to it.

// 24px line icons, drawn at 20px.
const icons = {
  internet:
    '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.1 3.6 8.5s-1.2 6.2-3.6 8.5c-2.4-2.3-3.6-5.1-3.6-8.5s1.2-6.2 3.6-8.5Z"/>',
  router:
    '<rect x="3" y="12" width="18" height="7" rx="1.5"/><path d="M8 12V6M16 12V6M7 15.5h1"/>',
  ap: '<path d="M4.5 10a11 11 0 0 1 15 0M7.5 13a6.5 6.5 0 0 1 9 0"/><circle cx="12" cy="16.5" r="1"/>',
  switch:
    '<rect x="2.5" y="8" width="19" height="8" rx="1.5"/><path d="M6 12h1M10 12h1M14 12h1M18 12h1"/>',
  server:
    '<rect x="4" y="3.5" width="16" height="7.5" rx="1.5"/><rect x="4" y="13" width="16" height="7.5" rx="1.5"/><path d="M7.5 7.25h1M7.5 16.75h1"/>',
  desktop:
    '<rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M12 16v4M8.5 20h7"/>',
};

// A node: its icon's left edge (x) and centre line (cy), an optional role
// above the name, and the name in one or two lines.
type Node = {
  id: NodeId;
  x: number;
  cy: number;
  icon: keyof typeof icons;
  role?: string;
  name: string[];
};
type Link = { d: string; step: number };
// A label on a link: beside it, or ending just before it (end).
type Label = { x: number; y: number; text: string; end?: boolean };
type NodeId = "internet" | "router" | "ap" | "switch" | "desktop" | "server";
// The packets' hops: each lies on the drawn links, from one node's exit
// to the next node's icon. A node's route is the hops from the Internet.
type Hop = "up" | "toAp" | "toSwitch" | "toDesktop" | "toServer";
type Layout = {
  box: string;
  nodes: Node[];
  links: Link[];
  labels: Label[];
  hops: Record<Hop, string>;
  // Where the access point's broadcast starts: just past its name, so the
  // arcs only ever cross empty frame.
  broadcast: { x: number; y: number };
};
const routes: Record<NodeId, Hop[]> = {
  internet: [],
  router: ["up"],
  ap: ["up", "toAp"],
  switch: ["up", "toSwitch"],
  desktop: ["up", "toDesktop"],
  server: ["up", "toSwitch", "toServer"],
};

const ROUTER = ["MikroTik Chateau", "5G R17 ax"];

// Wide: 556 x 156.
const wide: Layout = {
  box: "0 6 556 156",
  nodes: [
    { id: "internet", x: 0, cy: 24, icon: "internet", name: ["Internet (5G)"] },
    {
      id: "router",
      x: 0,
      cy: 88,
      icon: "router",
      role: "Router",
      name: ROUTER,
    },
    {
      id: "ap",
      x: 240,
      cy: 24,
      icon: "ap",
      role: "Access point",
      name: ["Omada EAP610"],
    },
    {
      id: "switch",
      x: 240,
      cy: 88,
      icon: "switch",
      role: "Switch",
      name: ["Netgear GS108"],
    },
    { id: "desktop", x: 240, cy: 152, icon: "desktop", name: ["Desktop"] },
    {
      id: "server",
      x: 436,
      cy: 88,
      icon: "server",
      role: "Server",
      name: ["Lenovo V15"],
    },
  ],
  links: [
    { d: "M10 38V74", step: 0 },
    { d: "M176 88H212", step: 1 },
    { d: "M212 88V24H234", step: 2 },
    { d: "M212 88H234", step: 2 },
    { d: "M212 88V152H234", step: 2 },
    { d: "M400 88H428", step: 3 },
  ],
  // On the bus's upper stretch, which only the access point's link uses.
  labels: [{ x: 206, y: 60, text: "PoE", end: true }],
  hops: {
    up: "M10 38V74",
    toAp: "M176 88H212V24H234",
    toSwitch: "M176 88H234",
    toDesktop: "M176 88H212V152H234",
    toServer: "M400 88H428",
  },
  broadcast: { x: 400, y: 24 },
};

// Mid: 392 x 200.
const mid: Layout = {
  box: "0 6 392 200",
  nodes: [
    { id: "internet", x: 0, cy: 24, icon: "internet", name: ["Internet (5G)"] },
    {
      id: "router",
      x: 0,
      cy: 88,
      icon: "router",
      role: "Router",
      name: ROUTER,
    },
    {
      id: "ap",
      x: 240,
      cy: 24,
      icon: "ap",
      role: "Access point",
      name: ["Omada EAP610"],
    },
    {
      id: "switch",
      x: 240,
      cy: 88,
      icon: "switch",
      role: "Switch",
      name: ["Netgear GS108"],
    },
    {
      id: "server",
      x: 268,
      cy: 144,
      icon: "server",
      role: "Server",
      name: ["Lenovo V15"],
    },
    { id: "desktop", x: 240, cy: 196, icon: "desktop", name: ["Desktop"] },
  ],
  links: [
    { d: "M10 38V74", step: 0 },
    { d: "M176 88H212", step: 1 },
    { d: "M212 88V24H234", step: 2 },
    { d: "M212 88H234", step: 2 },
    { d: "M212 88V196H234", step: 2 },
    { d: "M250 102V144H262", step: 3 },
  ],
  labels: [{ x: 206, y: 60, text: "PoE", end: true }],
  hops: {
    up: "M10 38V74",
    toAp: "M176 88H212V24H234",
    toSwitch: "M176 88H234",
    toDesktop: "M176 88H212V196H234",
    toServer: "M250 102V144H262",
  },
  broadcast: { x: 400, y: 24 },
};

// Tall: 182 x 304.
const tall: Layout = {
  box: "0 4 182 304",
  nodes: [
    { id: "internet", x: 0, cy: 14, icon: "internet", name: ["Internet (5G)"] },
    {
      id: "router",
      x: 0,
      cy: 70,
      icon: "router",
      role: "Router",
      name: ROUTER,
    },
    {
      id: "ap",
      x: 28,
      cy: 136,
      icon: "ap",
      role: "Access point",
      name: ["Omada EAP610"],
    },
    {
      id: "switch",
      x: 28,
      cy: 194,
      icon: "switch",
      role: "Switch",
      name: ["Netgear GS108"],
    },
    {
      id: "server",
      x: 56,
      cy: 248,
      icon: "server",
      role: "Server",
      name: ["Lenovo V15"],
    },
    { id: "desktop", x: 28, cy: 298, icon: "desktop", name: ["Desktop"] },
  ],
  links: [
    { d: "M10 28V56", step: 0 },
    { d: "M10 84V136H22", step: 1 },
    { d: "M10 136V194H22", step: 2 },
    { d: "M10 194V298H22", step: 3 },
    { d: "M38 208V248H50", step: 3 },
  ],
  // On the trunk's first stretch, which only the access point's link uses.
  labels: [{ x: 18, y: 112, text: "PoE" }],
  hops: {
    up: "M10 28V56",
    toAp: "M10 84V136H22",
    toSwitch: "M10 84V194H22",
    toDesktop: "M10 84V298H22",
    toServer: "M38 208V248H50",
  },
  broadcast: { x: 186, y: 136 },
};

// The access point's broadcast: three arcs, a 60° wedge opening right,
// drawn at radius 1 around the start point and scaled out (motion.css,
// "the AP broadcast"; the stroke stays a hairline).
const arc = (x: number, y: number) =>
  `M${x + 0.866} ${y - 0.5}A1 1 0 0 1 ${x + 0.866} ${y + 0.5}`;

// Baselines: one line alone sits on the icon's centre line; a role and
// its name share it, the role above; two name lines go one under the other.
const lines = (n: Node) => {
  const role = n.role ? n.cy - (n.name.length > 1 ? 18 : 8) : null;
  const first = role === null ? n.cy + 6 : role + 20;
  return { role, names: n.name.map((t, i) => ({ t, y: first + i * 20 })) };
};
---

<figure class="map rv" aria-hidden="true">
  <span class="tick tl"></span>
  <span class="tick tr"></span>
  <span class="tick bl"></span>
  <span class="tick br"></span>
  {[
    { cls: "wide", ...wide },
    { cls: "mid", ...mid },
    { cls: "tall", ...tall },
  ].map(({ cls, box, nodes, links, labels, hops, broadcast }) => {
    const [, , w, h] = box.split(" ").map(Number);
    return (
      <svg class={cls} viewBox={box} width={w} height={h} role="presentation">
        {links.map((l) => (
          <path
            class="link"
            d={l.d}
            pathLength="1"
            style={`--step: ${l.step}`}
          />
        ))}
        {Object.entries(hops).map(([id, d]) => (
          <path class="hop" data-hop={id} d={d} />
        ))}
        <g class="broadcast" data-x={broadcast.x} data-y={broadcast.y}>
          {[0, 1, 2].map((i) => (
            <path d={arc(broadcast.x, broadcast.y)} style={`--i: ${i}`} />
          ))}
        </g>
        {labels.map((l) => (
          <text
            class="role"
            x={l.x}
            y={l.y}
            text-anchor={l.end ? "end" : undefined}
          >
            {l.text}
          </text>
        ))}
        {nodes.map((n) => {
          const t = lines(n);
          return (
            <g class="node" data-route={routes[n.id].join(" ")}>
              <g
                class="icon"
                transform={`translate(${n.x} ${n.cy - 10}) scale(${20 / 24})`}
                set:html={icons[n.icon]}
              />
              {t.role !== null && (
                <text class="role" x={n.x + 30} y={t.role}>
                  {n.role}
                </text>
              )}
              {t.names.map((line) => (
                <text class="name" x={n.x + 30} y={line.y}>
                  {line.t}
                </text>
              ))}
            </g>
          );
        })}
      </svg>
    );
  })}
</figure>

<script>
  // Packets on the homelab map. As the map comes in, one packet runs from
  // the Internet to each end of the tree (they share the first hop, so it
  // reads as one that splits at the router). When it reaches the access
  // point, the access point starts broadcasting: a wave of arcs to its
  // right every 3s, for as long as the map is on screen (motion.css, "the
  // AP broadcast"). Hovering a node (mouse) sends a packet to it; on the
  // access point, a wave goes out at once. Reduced motion: no packets or
  // waves; hovering lights the node's route in ink. Without JS: static.
  const calm = matchMedia("(prefers-reduced-motion: reduce)");
  const NS = "http://www.w3.org/2000/svg";
  const SPEED = 0.25; // px per ms

  for (const map of document.querySelectorAll<HTMLElement>(".map")) {
    const drawing = () =>
      [...map.querySelectorAll<SVGSVGElement>("svg")].find((svg) =>
        svg.checkVisibility(),
      );
    const hopsOf = (svg: SVGSVGElement, route: string[]) =>
      route
        .map((id) => svg.querySelector<SVGPathElement>(`[data-hop="${id}"]`))
        .filter((p): p is SVGPathElement => p !== null);

    // The broadcast's reach: up to 84px, never past the frame.
    const fit = () => {
      const frame = map.getBoundingClientRect();
      for (const svg of map.querySelectorAll<SVGSVGElement>("svg")) {
        const g = svg.querySelector<SVGGElement>(".broadcast");
        if (!g || !svg.checkVisibility()) continue;
        const box = svg.getBoundingClientRect();
        const vb = svg.viewBox.baseVal;
        const k = box.width / vb.width;
        const x = box.left + (Number(g.dataset.x) - vb.x) * k;
        const y = box.top + (Number(g.dataset.y) - vb.y) * k;
        const reach = Math.min(
          84,
          frame.right - 2 - x,
          2 * (y - frame.top - 2),
          2 * (frame.bottom - 2 - y),
        );
        g.style.setProperty("--rmax", String(Math.max(0, Math.floor(reach))));
      }
    };

    // One timeline for every wave: --t runs 0 to 1 every 3s (each arc
    // takes its share of it in CSS). Paused while the map is off screen.
    let wave: Animation | undefined;
    let onScreen = false;
    const broadcast = () => {
      if (calm.matches) return;
      if (!wave) {
        fit();
        wave = map.animate([{ "--t": 0 }, { "--t": 1 }], {
          duration: 3000,
          iterations: Infinity,
        });
        map.dataset.live = "";
        if (!onScreen) wave.pause();
        return;
      }
      // A wave on demand, never on top of one still spreading.
      if ((Number(wave.currentTime) || 0) % 3000 > 1200) wave.currentTime = 0;
    };
    new IntersectionObserver(([entry]) => {
      onScreen = !!entry?.isIntersecting;
      if (!wave) return;
      if (onScreen) wave.play();
      else wave.pause();
    }).observe(map);
    new ResizeObserver(fit).observe(map);

    // One packet along a route, hop by hop: it fades in leaving a node and
    // out arriving at the next (a hop starts past the node's name).
    const send = async (svg: SVGSVGElement, route: string[]) => {
      const dot = document.createElementNS(NS, "circle");
      dot.setAttribute("class", "packet");
      dot.setAttribute("r", "3");
      svg.append(dot);
      try {
        for (const path of hopsOf(svg, route)) {
          const length = path.getTotalLength();
          const steps = Math.max(2, Math.ceil(length / 4));
          const frames: Keyframe[] = [];
          for (let i = 0; i <= steps; i++) {
            const p = path.getPointAtLength((length * i) / steps);
            frames.push({
              transform: `translate(${p.x}px, ${p.y}px)`,
              opacity: i === 0 || i === steps ? 0 : 1,
            });
          }
          await dot.animate(frames, {
            duration: Math.max(160, length / SPEED),
            fill: "forwards",
          }).finished;
        }
        if (route.at(-1) === "toAp") broadcast();
      } catch {
        // Cancelled (the page went away): nothing to finish.
      } finally {
        dot.remove();
      }
    };

    // The tree's ends: routes no other route continues.
    const routes = [...map.querySelectorAll<SVGGElement>("[data-route]")]
      .map((g) => g.dataset.route ?? "")
      .filter(Boolean);
    const ends = [...new Set(routes)].filter(
      (r) => !routes.some((o) => o !== r && o.startsWith(`${r} `)),
    );

    // As the map comes in (Base.astro marks it .is-in), once the links
    // have drawn their first hops. A map shown settled (coming back to
    // the page) stays still: it never changes class while watched.
    new MutationObserver((_, observer) => {
      if (!map.classList.contains("is-in")) return;
      observer.disconnect();
      if (calm.matches) return;
      setTimeout(() => {
        const svg = drawing();
        if (svg) for (const r of ends) send(svg, r.split(" "));
      }, 1200);
    }).observe(map, { attributes: true, attributeFilter: ["class"] });

    const busy = new Set<string>();
    for (const node of map.querySelectorAll<SVGGElement>("[data-route]")) {
      const route = (node.dataset.route ?? "").split(" ").filter(Boolean);
      if (!route.length) continue;
      const svg = node.ownerSVGElement;
      if (!svg) continue;
      node.addEventListener("pointerenter", async (e) => {
        if (e.pointerType !== "mouse") return;
        if (calm.matches) {
          for (const hop of hopsOf(svg, route)) hop.classList.add("lit");
          return;
        }
        const key = route.join(" ");
        if (busy.has(key)) return;
        busy.add(key);
        await send(svg, route);
        busy.delete(key);
      });
      node.addEventListener("pointerleave", () => {
        for (const hop of hopsOf(svg, route)) hop.classList.remove("lit");
      });
    }
  }
</script>

<style>
  /* The frame is the query container: the wide drawing shows only where
     it fits at 1:1. */
  .map {
    position: relative;
    container-type: inline-size;
    overflow: clip;
    overflow-clip-margin: 1px;
    margin: 0 0 var(--sp-6);
    padding: var(--sp-5);
    border: var(--rule) solid var(--chip-line);
  }

  .tick {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 0 solid var(--soft);
  }

  .tl {
    top: -1px;
    left: -1px;
    border-width: 1px 0 0 1px;
  }

  .tr {
    top: -1px;
    right: -1px;
    border-width: 1px 1px 0 0;
  }

  .bl {
    bottom: -1px;
    left: -1px;
    border-width: 0 0 1px 1px;
  }

  .br {
    right: -1px;
    bottom: -1px;
    border-width: 0 1px 1px 0;
  }

  svg {
    display: block;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }

  .wide,
  .mid {
    display: none;
  }

  @container (min-width: 392px) {
    .mid {
      display: block;
    }

    .tall {
      display: none;
    }
  }

  @container (min-width: 556px) {
    .wide {
      display: block;
    }

    .mid {
      display: none;
    }
  }

  .icon {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .role {
    font: var(--fw-regular) var(--fs-xs) var(--ff-text);
    fill: var(--soft);
  }

  .name {
    font: var(--fw-medium) var(--fs-body) var(--ff-text);
    fill: var(--ink);
  }

  /* The packets' hops lie on the links, unseen; with reduced motion a
     hovered node's route lights up in ink. */
  .hop {
    fill: none;
    stroke: none;
  }

  .hop:global(.lit) {
    stroke: var(--ink);
    stroke-width: 1;
  }

  .node {
    pointer-events: bounding-box;
  }

  :global(.packet) {
    fill: var(--acc);
  }

  /* The AP broadcast (motion.css): each arc grows from 10px to the reach
     the frame allows and fades as it goes, 150ms after the one before,
     900ms each, in the first part of every 3s of --t. At --t 0 (no JS,
     reduced motion, before the first packet) they're unseen. */
  .broadcast path {
    --p: clamp(0, (var(--t) * 3000 - var(--i) * 150) / 900, 1);
    fill: none;
    stroke: var(--acc);
    stroke-width: 1.25;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    transform-box: fill-box;
    transform-origin: -0.866px 0.5px;
    transform: scale(calc(10 + var(--p) * (var(--rmax, 84) - 10)));
    opacity: calc(0.9 * min(var(--p) / 0.15, (1 - var(--p)) / 0.85));
    pointer-events: none;
  }

  .link {
    fill: none;
    stroke: var(--soft);
    stroke-width: 1;
  }

  /* The links draw once as the map scrolls in, hop by hop. */
  @media (prefers-reduced-motion: no-preference) {
    .link {
      stroke-dasharray: 1;
      transition: stroke-dashoffset 500ms var(--ease-out);
      transition-delay: calc(250ms + var(--step) * 220ms);
    }

    :global(.js) .map:not(:global(.is-in)) .link {
      stroke-dashoffset: 1;
    }
  }
</style>

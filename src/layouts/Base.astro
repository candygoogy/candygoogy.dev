---
// Page shell: fonts, tokens, header and footer, SEO tags, and the theme
// applied before first paint.
import { createHash } from "node:crypto";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { Font } from "astro:assets";
import Curtain from "../components/Curtain.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { hero, site } from "../data/site";
import { root } from "../lib/github";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/motion.css";
import "../styles/print.css";

interface Props {
  title: string;
  description: string;
  // Only the 404 page opts out of search engines.
  noindex?: boolean;
  // Only the home page has the intro curtain.
  intro?: boolean;
  // The social preview card and its description (default: the site's).
  ogImage?: string;
  ogAlt?: string;
  // Structured data (schema.org JSON-LD) for this page.
  schema?: Record<string, unknown>;
  // The header nav item this page belongs under (product pages: Projects).
  section?: string;
}

const {
  title,
  description,
  noindex = false,
  intro = false,
  ogImage: ogPath = "/og.png",
  ogAlt = `${site.name}: ${hero.headline}`,
  schema,
  section,
} = Astro.props;
// Pages are built as files (index.html, fettle.html), but served and
// listed in the sitemap without the extension: / and /fettle.
const pagePath = Astro.url.pathname
  .replace(/\.html$/, "")
  .replace(/\/index$/, "/");
const canonical = new URL(pagePath, Astro.site);
const ogImage = new URL(ogPath, Astro.site);

// The icons are made from the GitHub avatar at build time
// (scripts/icons.mjs). Browsers keep favicons for a long time, so the URL
// carries a hash of the file: a new avatar gets a new URL.
const icon = (file: string) => {
  const path = join(root, "public", file);
  if (!existsSync(path)) return `/${file}`;
  const hash = createHash("sha256").update(readFileSync(path)).digest("hex");
  return `/${file}?v=${hash.slice(0, 10)}`;
};

// Pages open at once: in Chromium, pointing at a link to another page here
// (pressing it, on touch) fetches that page ahead, so the transition to it
// doesn't wait on the network. Only the page's HTML is fetched, and nothing
// on it runs until it's opened. Not the API, plain files, feeds and
// pictures, or links marked nofollow or download. Hashed into each page's
// script-src (scripts/csp.mjs), where Chromium checks it.
const speculation = {
  prefetch: [
    {
      where: {
        and: [
          { href_matches: "/*" },
          { not: { href_matches: "/api/*" } },
          { not: { href_matches: "/*.txt" } },
          { not: { href_matches: "/*.xml" } },
          { not: { href_matches: "/*.png" } },
          { not: { href_matches: "/.well-known/*" } },
          { not: { selector_matches: "[rel~=nofollow]" } },
          { not: { selector_matches: "[download]" } },
        ],
      },
      eagerness: "moderate",
    },
  ],
};
---

<!doctype html>
<Fragment set:html="<!-- Hi. Curious how this works? The source is at github.com/candygoogy/candygoogy.dev -->" />
<html lang="en" data-intro-page={intro ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#f4f4f5"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#121214"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href={icon("favicon.ico")} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={icon("apple-touch-icon.png")} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title={site.name}
      href="/feed.xml"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(schema).replace(/</g, "\\u003c")}
      />
    )}
    <script is:inline>
      // Before first paint: apply a saved theme so there's no flash. No saved
      // choice means Auto (follow the OS). Also marks JS as available: the
      // hero's entrance and the intro only play with it (motion.css).
      (() => {
        const root = document.documentElement;
        if ("IntersectionObserver" in window) root.classList.add("js");
        try {
          let theme = localStorage.getItem("theme");
          // The OLED theme was retired: returning visitors move to Dark.
          if (theme === "oled") {
            theme = "dark";
            localStorage.setItem("theme", theme);
          }
          if (theme === "light" || theme === "dark") {
            root.dataset.theme = theme;
            document
              .querySelector('meta[name="color-scheme"]')
              ?.setAttribute("content", theme === "light" ? "light" : "dark");
            // The browser bar follows the chosen theme, not the OS: both
            // theme-color metas take its page color (the switch restores
            // them on Auto). Keep in step with --bg in tokens.css.
            const bg = theme === "light" ? "#f4f4f5" : "#121214";
            for (const m of document.querySelectorAll(
              'meta[name="theme-color"]',
            ))
              m.setAttribute("content", bg);
          }
        } catch {
          // Storage blocked: stay on Auto.
        }
        // The intro curtain greets a visitor who lands on the home page:
        // only when it's the session's first page (every page marks the
        // session seen, so coming home from another page never plays it),
        // never under reduced motion or without the motion system.
        // intro-hold keeps the hero's reveal waiting until the curtain lifts.
        try {
          const first = !sessionStorage.getItem("intro-seen");
          sessionStorage.setItem("intro-seen", "1");
          if (
            first &&
            root.hasAttribute("data-intro-page") &&
            root.classList.contains("js") &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            // intro-played stays after the curtain is gone (motion.css).
            root.classList.add("intro-on", "intro-hold", "intro-played");
            // If the curtain never releases the page (its script failed to
            // load), the hero plays anyway after 2.6s (motion.css).
            setTimeout(() => root.classList.add("intro-late"), 2600);
          }
        } catch {
          // Storage blocked: no intro.
        }
        // A page left partway down notes so as it goes, under its own path
        // (never the position), so leaving another page doesn't wipe it. If
        // it comes back with a reload, Back or Forward, the hero starts at
        // rest (html.hero-rest, motion.css): the browser puts the scroll
        // back by lining up what sits near the window's top, and the hero's
        // entrance, still holding it lowered then, would make the page land
        // too far down. One left at the top plays it as usual, and a page
        // restored from the back/forward cache never runs this at all.
        const key = "left-down:" + location.pathname;
        addEventListener("pagehide", () => {
          try {
            if (scrollY > 0) sessionStorage.setItem(key, "1");
            else sessionStorage.removeItem(key);
          } catch {
            // Storage blocked: nothing noted.
          }
        });
        try {
          const left = sessionStorage.getItem(key);
          sessionStorage.removeItem(key);
          const type = performance.getEntriesByType("navigation")[0]?.type;
          if (left && (type === "reload" || type === "back_forward"))
            root.classList.add("hero-rest");
        } catch {
          // Storage blocked: the hero plays.
        }
      })();
    </script>
    <script is:inline>
      // Navigations between pages (motion.css, "Cross-document View
      // Transitions"). Each transition is typed by its direction, forward
      // or back. A shared element (the project's name, its screenshot) only
      // morphs when at least 40% of it is on screen on both pages. One
      // that's on screen on only one page still gets its own layer, and
      // leaves or arrives with its page (so the name is always drawn above
      // a screenshot passing by). Arriving with a transition, or
      // coming back, all that's in view is shown settled instead of playing
      // its reveal: the page's slide is its entrance, and the morphs land
      // on finished elements. (A reload, Back or Forward that lands partway
      // down shows the hero at rest, decided earlier in the script above:
      // it has to be at rest before the scroll is put back.) A page restored from the back/forward cache
      // arrives as it was left, with no transition: Chromium paints the
      // restored page for a frame before the transition's first frame, so
      // one would read as a cut back to the old page and a fade. Registered
      // here, before first paint.
      (() => {
        const REVEALS =
          ".rv, .rv-mask, .rv-line, .rv-band, .letters, .hero-title, .line-title, .heat-draw";
        const inView = (el) => {
          const r = el.getBoundingClientRect();
          return r.width > 0 && r.bottom > 0 && r.top < innerHeight;
        };
        // Enough of it on screen to follow from one page to the other.
        const shown = (el) => {
          const r = el.getBoundingClientRect();
          const seen = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0);
          return r.width > 0 && seen >= 0.4 * Math.min(r.height, innerHeight);
        };
        let restored = false;
        // The link last activated (a click, or Enter on it). Forgotten when
        // the page shows again, so it never outlives a visit.
        let link = null;
        document.addEventListener(
          "click",
          (e) => {
            link = e.target.closest?.("a");
          },
          true,
        );
        addEventListener("pageshow", (e) => {
          restored = e.persisted;
          link = null;
        });
        const direction = (a) =>
          a?.navigationType === "traverse" &&
          a.from &&
          a.entry.index < a.from.index
            ? "back"
            : "forward";
        // Each name goes to one element at most (two with the same name
        // would cancel the whole transition): of those shown enough, the
        // one inside the link that was followed (`from`), or else the one
        // with the most of it on screen (on the home page, the hero
        // index's Fettle row or the band's heading). Recomputed on every
        // navigation (a page restored from the back/forward cache keeps
        // its inline styles). Returns the named elements.
        const name = (from) => {
          const kept = [];
          for (const sel of [".vt-project-title", ".vt-project-shot"]) {
            let best;
            let most = 0;
            for (const el of document.querySelectorAll(sel)) {
              el.style.viewTransitionName = "none";
              const r = el.getBoundingClientRect();
              const area = from?.contains(el)
                ? Infinity
                : r.width *
                  (Math.min(r.bottom, innerHeight) - Math.max(r.top, 0));
              if (shown(el) && area > most) {
                best = el;
                most = area;
              }
            }
            if (best) {
              best.style.viewTransitionName = "";
              kept.push(best);
            }
          }
          return kept;
        };
        // Revealed at once: the element and the reveals around it, with
        // their entrance transitions and animations run to the end.
        const settle = (els) => {
          for (const el of els) {
            // checkVisibility() throws on older iOS Safari (as in
            // scripts/motion.ts, which this inline script can't import).
            const imgs = [...el.querySelectorAll("img")].filter((img) =>
              typeof img.checkVisibility === "function"
                ? img.checkVisibility()
                : img.getClientRects().length > 0,
            );
            for (const img of imgs) {
              img.loading = "eager";
              img.fetchPriority = "high";
              // Painted in the transition's first frame, not the next.
              img.decoding = "sync";
            }
            // A screenshot that hasn't loaded yet would arrive as an empty
            // frame and pop in: it waits unseen and fades in once decoded
            // (at most 2.5s).
            if (
              el.hasAttribute("data-decode") &&
              imgs.some((img) => !img.complete)
            ) {
              el.style.opacity = "0";
              Promise.race([
                Promise.allSettled(imgs.map((img) => img.decode())),
                new Promise((resolve) => setTimeout(resolve, 2500)),
              ]).then(() => {
                el.style.transition = "opacity 220ms var(--ease-out)";
                el.style.opacity = "";
                el.addEventListener(
                  "transitionend",
                  () => el.style.removeProperty("transition"),
                  { once: true },
                );
              });
            }
            for (let x = el; x; x = x.parentElement?.closest(REVEALS)) {
              if (x.matches(REVEALS)) x.classList.add("is-in");
            }
          }
          for (const el of els) {
            const root = el.closest(".rv-band") ?? el;
            for (const a of root.getAnimations({ subtree: true })) {
              if (a.effect?.getComputedTiming().endTime !== Infinity)
                a.finish();
            }
          }
        };
        addEventListener("pageswap", (e) => {
          if (!e.viewTransition) return;
          e.viewTransition.types.add(direction(e.activation));
          name(e.activation?.navigationType === "traverse" ? null : link);
        });
        addEventListener("pagereveal", (e) => {
          if (restored) {
            restored = false;
            // Skipping rejects its ready promise; caught, so a restore
            // never logs an error.
            e.viewTransition?.ready.catch(() => {});
            e.viewTransition?.skipTransition();
            return;
          }
          const nav = window.navigation?.activation;
          const landing = [];
          if (e.viewTransition) {
            e.viewTransition.types.add(direction(nav));
            landing.push(...name());
          }
          if (e.viewTransition || nav?.navigationType === "traverse") {
            for (const el of document.querySelectorAll(REVEALS)) {
              if (inView(el)) landing.push(el);
            }
          }
          if (landing.length) settle(landing);
        });
      })();
    </script>
    <script
      type="speculationrules"
      is:inline
      set:html={JSON.stringify(speculation)}
    />
    <link rel="expect" href="#main" blocking="render" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-text" preload />
    <slot name="head" />
  </head>
  <body>
    {intro && <Curtain />}
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header section={section} />
    <main id="main" class="wrap">
      <slot />
    </main>
    <Footer />
    <script>
      // The page's motion and pointer details (scripts/loader.ts). In the
      // built site this tag is made inert (scripts/motion-loader.mjs) and
      // the script below starts it; in development it simply runs.
      import "../scripts/loader";
    </script>
    <script is:inline>
      // Starts the page's motion once the page has first painted, so the
      // first paint never waits for it and its files aren't even requested
      // before then. Without JS, nothing here matters: content never
      // depends on it.
      (() => {
        let started = false;
        const start = () => {
          if (started) return;
          const tag = document.querySelector(
            'script[type="text/motion-loader"]',
          );
          if (!tag) {
            // Not parsed yet: try again once it is (in development there's
            // no tag, and the loader has run on its own).
            if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", start, {
                once: true,
              });
            }
            return;
          }
          started = true;
          const script = document.createElement("script");
          script.type = "module";
          script.src = tag.dataset.src;
          // Its file gone, most likely a deploy since this page loaded:
          // reload for the current one, once, as loader.ts does for its
          // own modules (and with the same key). loader.ts clears it once
          // it and all its modules have loaded; clearing it here, on load,
          // could loop if one of those keeps failing.
          script.onerror = () => {
            try {
              if (navigator.onLine && !sessionStorage.getItem("stale-reload")) {
                sessionStorage.setItem("stale-reload", "1");
                location.reload();
              }
            } catch {
              // No sessionStorage: the page stays as it is.
            }
          };
          document.head.append(script);
        };
        // The load event often comes before the first paint, so it's only
        // the fallback: 1s after it if the paint is never reported (as in a
        // background tab), or at once without paint timing.
        let fallback = 0;
        try {
          new PerformanceObserver((list, observer) => {
            if (!list.getEntriesByName("first-contentful-paint").length) return;
            observer.disconnect();
            start();
          }).observe({ type: "paint", buffered: true });
          fallback = 1000;
        } catch {
          // No paint timing: the load event starts it.
        }
        addEventListener("load", () => setTimeout(start, fallback), {
          once: true,
        });
      })();
    </script>
  </body>
</html>

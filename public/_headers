# Cloudflare static assets: response headers by path.
# Astro's build output under /_astro/ is content-hashed, so it never
# changes in place and can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The feed (src/pages/feed.xml.ts) as Atom: by its extension alone it
# would go out as plain XML.
/feed.xml
  Content-Type: application/atom+xml; charset=utf-8

# Each page carries its own Content-Security-Policy in a <meta>, with the
# hashes of its own scripts and styles (scripts/csp.mjs). This one adds
# what a <meta> can't: no other site may frame these pages. Both apply.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none';
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  x-hello: Hi. Curious how this works? The source is at github.com/candygoogy/candygoogy.dev
